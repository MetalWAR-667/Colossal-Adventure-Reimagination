        <object id="N_LOC_WESTBANK" label="&lt;b&gt;LOC_WESTBANK — on west bank of fissure&lt;/b&gt;&lt;hr size='1'/&gt;You are on the west side of the fissure in the Hall of Mists.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXITS (source precedence order)&lt;/b&gt;&lt;br&gt;1. JUMP ✕ msg CROSS_BRIDGE [not FISSURE=UNBRIDGED]&lt;br&gt;2. FORWA → LOC_NOMAKE [Ch 11] [not FISSURE=BRIDGED]&lt;br&gt;3. OVER, ACROS, EAST, CROSS ✕ msg NO_CROSS [not FISSURE=BRIDGED]&lt;br&gt;4. OVER → LOC_EASTBANK&lt;br&gt;5. NORTH → LOC_PARALLEL1 [Ch 04]&lt;br&gt;6. WEST → LOC_MISTWEST [Ch 04]" source_id="LOC_WESTBANK" description_en="You are on the west side of the fissure in the Hall of Mists." description_es="" short_en="You're on west bank of fissure." maptag="" chapter_id="CH_ENTRY" source_reference="Open_Adventure.yaml locations/LOC_WESTBANK" review_status="ok" role="playable" conditions="DEEP=True" travel_rules="[{&quot;action_full&quot;: [&quot;speak&quot;, &quot;CROSS_BRIDGE&quot;], &quot;action_target&quot;: &quot;CROSS_BRIDGE&quot;, &quot;action_type&quot;: &quot;speak&quot;, &quot;cond&quot;: {&quot;object&quot;: &quot;FISSURE&quot;, &quot;state&quot;: &quot;UNBRIDGED&quot;, &quot;type&quot;: &quot;not&quot;}, &quot;verbs&quot;: [&quot;JUMP&quot;]}, {&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_NOMAKE&quot;], &quot;action_target&quot;: &quot;LOC_NOMAKE&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: {&quot;object&quot;: &quot;FISSURE&quot;, &quot;state&quot;: &quot;BRIDGED&quot;, &quot;type&quot;: &quot;not&quot;}, &quot;verbs&quot;: [&quot;FORWA&quot;]}, {&quot;action_full&quot;: [&quot;speak&quot;, &quot;NO_CROSS&quot;], &quot;action_target&quot;: &quot;NO_CROSS&quot;, &quot;action_type&quot;: &quot;speak&quot;, &quot;cond&quot;: {&quot;object&quot;: &quot;FISSURE&quot;, &quot;state&quot;: &quot;BRIDGED&quot;, &quot;type&quot;: &quot;not&quot;}, &quot;verbs&quot;: [&quot;OVER&quot;, &quot;ACROS&quot;, &quot;EAST&quot;, &quot;CROSS&quot;]}, {&quot;action_full&quot