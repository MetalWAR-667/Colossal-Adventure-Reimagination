        <object id="N_LOC_COBBLE" label="&lt;b&gt;LOC_COBBLE — in cobble crawl&lt;/b&gt;&lt;hr size='1'/&gt;You are crawling over cobbles in a low passage.  There is a dim light&lt;br&gt;at the east end of the passage.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXITS (source precedence order)&lt;/b&gt;&lt;br&gt;1. OUT, SURFA, EAST → LOC_BELOWGRATE&lt;br&gt;2. INWAR, DARK, WEST, DEBRI → LOC_DEBRIS&lt;br&gt;3. PIT → LOC_PITTOP" source_id="LOC_COBBLE" description_en="You are crawling over cobbles in a low passage.  There is a dim light&#10;at the east end of the passage." description_es="" short_en="You're in cobble crawl." maptag="" chapter_id="CH_ENTRY" source_reference="Open_Adventure.yaml locations/LOC_COBBLE" review_status="ok" role="playable" conditions="LIT=True" travel_rules="[{&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_BELOWGRATE&quot;], &quot;action_target&quot;: &quot;LOC_BELOWGRATE&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;OUT&quot;, &quot;SURFA&quot;, &quot;EAST&quot;]}, {&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_DEBRIS&quot;], &quot;action_target&quot;: &quot;LOC_DEBRIS&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;INWAR&quot;, &quot;DARK&quot;, &quot;WEST&quot;, &quot;DEBRI&quot;]}, {&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_PITTOP&quot;], &quot;action_target&quot;: &quot;LOC_PITTOP&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;PIT&quot;]}]" objects_here="CAGE">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;arcSize=4;fontSize=10;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1">
            <mxGeometry x="1810" y="660" width="290" height="160" as="geometry" />
