        <object id="N_LOC_MISTHALL" label="&lt;b&gt;LOC_MISTHALL — in Hall of Mists&lt;/b&gt;&lt;hr size='1'/&gt;You are at one end of a vast hall stretching forward out of sight to&lt;br&gt;the west.  There are openings to either side.  Nearby, a wide stone&lt;br&gt;staircase leads downward.  The hall is filled with wisps of white mist&lt;br&gt;swaying to and fro almost as if alive.  A cold wind blows up the&lt;br&gt;staircase.  There is a passage at the top of a dome behind you.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXITS (source precedence order)&lt;/b&gt;&lt;br&gt;1. LEFT, SOUTH → LOC_NUGGET&lt;br&gt;2. FORWA, HALL, WEST → LOC_EASTBANK&lt;br&gt;3. STAIR, DOWN, NORTH → LOC_KINGHALL [Ch 03]&lt;br&gt;4. UPWAR, PIT, STEPS, DOME, PASSA, EAST → LOC_DOME [Ch 11] [carry NUGGET]&lt;br&gt;5. UPWAR → LOC_PITTOP&lt;br&gt;6. Y2 → LOC_JUMBLE [Ch 10]" source_id="LOC_MISTHALL" description_en="You are at one end of a vast hall stretching forward out of sight to&#10;the west.  There are openings to either side.  Nearby, a wide stone&#10;staircase leads downward.  The hall is filled with wisps of white mist&#10;swaying to and fro almost as if alive.  A cold wind blows up the&#10;staircase.  There is a passage at the top of a dome behind you." description_es="" short_en="You're in Hall of Mists." maptag="" chapter_id="CH_ENTRY" source_reference="Open_Adventure.yaml locations/LOC_MISTHALL" review_status="ok" role="playable" conditions="DEEP=True" travel_rules="[{&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_NUGGET&quot;], &quot;action_target&quot;: &quot;LOC_NUGGET&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;LEFT&quot;, &quot;SOUTH&quot;]}, {&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_EASTBANK&quot;], &quot;action_target&quot;: &quot;LOC_EASTBANK&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;FORWA&quot;, &quot;HALL&quot;, &quot;WEST&quot;]}, {&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_KINGHALL&quot;], &quot;action_target&quot;: &quot;LOC_KINGHALL&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;STAIR&quot;, &quot;DOWN&quot;, &quot;NORTH&quot;]}, {&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_DOME&quot;], &quot;action_target&quot;: &quot;LOC_DOME&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: {&quot;object&quot;: &quot;NUGGET&quot;, &quot;type&quot;: &quot;carry&quot;}, &quot;verbs&quot;: [&quot;UPWAR&quot;, &quot;PIT&quot;, &quot;STEPS&quot;, &quot;DOME&quot;, &quot;PASSA&quot;, &quot;EAST&quot;]}, {&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_PITTOP&quot;], &quot;action_target&quot;: &quot;LOC_PITTOP&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;UPWAR&quot;]}, {&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_JUMBLE&quot;], &quot;action_target&quot;: &quot;LOC_JUMBLE&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;Y2&quot;]}]" objects_here="STEPS" immovable_objects_here="STEPS" sound="WIND_WHISTLES">
