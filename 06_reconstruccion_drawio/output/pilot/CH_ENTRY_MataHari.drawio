        </object>
        <object label="&lt;b&gt;LOC_NUGGET — in nugget-of-gold room&lt;/b&gt;&lt;br&gt;&lt;br&gt;This is a low room with a crude note on the wall.  The note says,&lt;br&gt;&amp;quot;You won&amp;#x27;t get it up the steps&amp;quot;.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXITS (source order)&lt;/b&gt;&lt;br&gt;HALL → LOC_MISTHALL" source_id="LOC_NUGGET" description_en="This is a low room with a crude note on the wall.  The note says,&#10;&quot;You won't get it up the steps&quot;." description_es="" short_en="You're in nugget-of-gold room." maptag="" chapter_id="CH_ENTRY" source_reference="Open_Adventure.yaml locations/LOC_NUGGET" review_status="ok" role="playable" conditions="DEEP=True" objects_here="OBJ_48, NUGGET" treasures_here="NUGGET" immovable_objects_here="OBJ_48">
