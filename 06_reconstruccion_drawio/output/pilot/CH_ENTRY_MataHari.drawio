        <object label="&lt;b&gt;LOC_WESTBANK — on west bank of fissure&lt;/b&gt;&lt;br&gt;&lt;br&gt;You are on the west side of the fissure in the Hall of Mists.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXITS (source order)&lt;/b&gt;&lt;br&gt;JUMP → say CROSS_BRIDGE [not FISSURE=UNBRIDGED]&lt;br&gt;FORWA → LOC_NOMAKE · 11 — Special &amp;amp; Transient States [not FISSURE=BRIDGED]&lt;br&gt;OVER → say NO_CROSS [not FISSURE=BRIDGED]&lt;br&gt;OVER → LOC_EASTBANK&lt;br&gt;north → LOC_PARALLEL1 · 04 — Maze (All Alike)&lt;br&gt;west → LOC_MISTWEST · 04 — Maze (All Alike)" source_id="LOC_WESTBANK" description_en="You are on the west side of the fissure in the Hall of Mists." description_es="" short_en="You're on west bank of fissure." maptag="" chapter_id="CH_ENTRY" source_reference="Open_Adventure.yaml locations/LOC_WESTBANK" review_status="ok" role="playable" conditions="DEEP=True" objects_here="FISSURE, OBJ_51" treasures_here="OBJ_51" immovable_objects_here="FISSURE">
