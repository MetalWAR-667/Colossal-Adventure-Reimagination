          </mxCell>
        </object>
        <object label="&lt;b&gt;LOC_PITTOP — at top of small pit&lt;/b&gt;&lt;br&gt;&lt;br&gt;At your feet is a small pit breathing traces of white mist.  An east&lt;br&gt;passage ends here except for a small crack leading on.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXITS (source order)&lt;/b&gt;&lt;br&gt;DEPRE → LOC_GRATE · 01 — Surface World [not GRATE=GRATE_CLOSED]&lt;br&gt;ENTRA → LOC_BELOWGRATE&lt;br&gt;DEBRI → LOC_DEBRIS&lt;br&gt;PASSA → LOC_BIRDCHAMBER&lt;br&gt;d → LOC_NECKBROKE · 11 — Special &amp;amp; Transient States [carry NUGGET]&lt;br&gt;d → LOC_MISTHALL&lt;br&gt;CRACK → LOC_CRACK" source_id="LOC_PITTOP" description_en="At your feet is a small pit breathing traces of white mist.  An east&#10;passage ends here except for a small crack leading on." description_es="" short_en="You're at top of small pit." maptag="" chapter_id="CH_ENTRY" source_reference="Open_Adventure.yaml locations/LOC_PITTOP" review_status="ok" role="playable" conditions="" objects_here="STEPS" immovable_objects_here="STEPS">
