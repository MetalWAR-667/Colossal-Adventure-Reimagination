        </object>
        <object label="&lt;b&gt;LOC_BELOWGRATE — below the grate&lt;/b&gt;&lt;br&gt;&lt;br&gt;You are in a small chamber beneath a 3x3 steel grate to the surface.&lt;br&gt;A low crawl over cobbles leads inward to the west.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXITS (source order)&lt;/b&gt;&lt;br&gt;OUT → LOC_GRATE · 01 — Surface World [not GRATE=GRATE_CLOSED]&lt;br&gt;OUT → say GRATE_NOWAY&lt;br&gt;crawl → LOC_COBBLE&lt;br&gt;PIT → LOC_PITTOP&lt;br&gt;DEBRI → LOC_DEBRIS" source_id="LOC_BELOWGRATE" description_en="You are in a small chamber beneath a 3x3 steel grate to the surface.&#10;A low crawl over cobbles leads inward to the west." description_es="" short_en="You're below the grate." maptag="" chapter_id="CH_ENTRY" source_reference="Open_Adventure.yaml locations/LOC_BELOWGRATE" review_status="ok" role="playable" conditions="LIT=True" objects_here="GRATE" immovable_objects_here="GRATE">
          <mxCell id="CH_ENTRY_LOC_BELOWGRATE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;arcSize=6;fontSize=11;fontFamily=Helvetica;verticalAlign=top;spacingTop=2;" vertex="1" parent="1">
            <mxGeometry x="2600" y="520" width="300" height="220" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;LOC_BIRDCHAMBER — in bird chamber&lt;/b&gt;&lt;br&gt;&lt;br&gt;You are in a splendid chamber thirty feet high.  The walls are frozen&lt;br&gt;rivers of orange stone.  An awkward canyon and a good passage exit&lt;br&gt;from east and west sides of the chamber.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXITS (source order)&lt;/b&gt;&lt;br&gt;DEPRE → LOC_GRATE · 01 — Surface World [not GRATE=GRATE_CLOSED]&lt;br&gt;ENTRA → LOC_BELOWGRATE&lt;br&gt;DEBRI → LOC_DEBRIS&lt;br&gt;CANYO → LOC_AWKWARD&lt;br&gt;PASSA → LOC_PITTOP" source_id="LOC_BIRDCHAMBER" description_en="You are in a splendid chamber thirty feet high.  The walls are frozen&#10;rivers of orange stone.  An awkward canyon and a good passage exit&#10;from east and west sides of the chamber." description_es="" short_en="You're in bird chamber." maptag="" chapter_id="CH_ENTRY" source_reference="Open_Adventure.yaml locations/LOC_BIRDCHAMBER" review_status="ok" role="playable" conditions="" objects_here="BIRD">
          <mxCell id="CH_ENTRY_LOC_BIRDCHAMBER" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;arcSize=6;fontSize=11;fontFamily=Helvetica;verticalAlign=top;spacingTop=2;" vertex="1" parent="1">
            <mxGeometry x="1160" y="520" width="300" height="230" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;LOC_COBBLE — in cobble crawl&lt;/b&gt;&lt;br&gt;&lt;br&gt;You are crawling over cobbles in a low passage.  There is a dim light&lt;br&gt;at the east end of the passage.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXITS (source order)&lt;/b&gt;&lt;br&gt;OUT → LOC_BELOWGRATE&lt;br&gt;INWAR → LOC_DEBRIS&lt;br&gt;PIT → LOC_PITTOP" source_id="LOC_COBBLE" description_en="You are crawling over cobbles in a low passage.  There is a dim light&#10;at the east end of the passage." description_es="" short_en="You're in cobble crawl." maptag="" chapter_id="CH_ENTRY" source_reference="Open_Adventure.yaml locations/LOC_COBBLE" review_status="ok" role="playable" conditions="LIT=True" objects_here="CAGE">
          <mxCell id="CH_ENTRY_LOC_COBBLE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;arcSize=6;fontSize=11;fontFamily=Helvetica;verticalAlign=top;spacingTop=2;" vertex="1" parent="1">
