        <object label="&lt;b&gt;LOC_CLIFFACE — Vertical cliff.&lt;/b&gt;&lt;br&gt;&lt;br&gt;You are climbing along a nearly vertical cliff." source_id="LOC_CLIFFACE" description_en="You are climbing along a nearly vertical cliff." description_es="" short_en="" maptag="Vertical cliff." chapter_id="CH_RESERVOIR" source_reference="Open_Adventure.yaml locations/LOC_CLIFFACE" review_status="ok" role="playable" conditions="DEEP=True">
