          <mxGeometry x="40" y="10" width="520" height="30" as="geometry"/>
        </mxCell>
        <object label="&lt;b&gt;LOC_AWKWARD — Awkward canyon.&lt;/b&gt;&lt;br&gt;&lt;br&gt;You are in an awkward sloping east/west canyon." source_id="LOC_AWKWARD" description_en="You are in an awkward sloping east/west canyon." description_es="" short_en="" maptag="Awkward canyon." chapter_id="CH_ENTRY" source_reference="Open_Adventure.yaml locations/LOC_AWKWARD" review_status="ok" role="playable" conditions="">
          <mxCell id="CH_ENTRY_LOC_AWKWARD" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;arcSize=6;" vertex="1" parent="1">
            <mxGeometry x="40" y="40" width="260" height="110" as="geometry"/>
          </mxCell>
        </object>
        <object label="&lt;b&gt;LOC_BELOWGRATE — below the grate&lt;/b&gt;&lt;br&gt;&lt;br&gt;You are in a small chamber beneath a 3x3 steel grate to the surface.&lt;br&gt;A low crawl over cobbles leads inward to the west." source_id="LOC_BELOWGRATE" description_en="You are in a small chamber beneath a 3x3 steel grate to the surface.&#10;A low crawl over cobbles leads inward to the west." description_es="" short_en="You're below the grate." maptag="" chapter_id="CH_ENTRY" source_reference="Open_Adventure.yaml locations/LOC_BELOWGRATE" review_status="ok" role="playable" conditions="LIT=True" objects_here="GRATE" immovable_objects_here="GRATE">
          <mxCell id="CH_ENTRY_LOC_BELOWGRATE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;arcSize=6;" vertex="1" parent="1">
            <mxGeometry x="360" y="40" width="260" height="110" as="geometry"/>
          </mxCell>
        </object>
        <object label="&lt;b&gt;LOC_BIRDCHAMBER — in bird chamber&lt;/b&gt;&lt;br&gt;&lt;br&gt;You are in a splendid chamber thirty feet high.  The walls are frozen&lt;br&gt;rivers of orange stone.  An awkward canyon and a good passage exit&lt;br&gt;from east and west sides of the chamber." source_id="LOC_BIRDCHAMBER" description_en="You are in a splendid chamber thirty feet high.  The walls are frozen&#10;rivers of orange stone.  An awkward canyon and a good passage exit&#10;from east and west sides of the chamber." description_es="" short_en="You're in bird chamber." maptag="" chapter_id="CH_ENTRY" source_reference="Open_Adventure.yaml locations/LOC_BIRDCHAMBER" review_status="ok" role="playable" conditions="" objects_here="BIRD">
          <mxCell id="CH_ENTRY_LOC_BIRDCHAMBER" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;arcSize=6;" vertex="1" parent="1">
            <mxGeometry x="680" y="40" width="260" height="110" as="geometry"/>
          </mxCell>
        </object>
        <object label="&lt;b&gt;LOC_COBBLE — in cobble crawl&lt;/b&gt;&lt;br&gt;&lt;br&gt;You are crawling over cobbles in a low passage.  There is a dim light&lt;br&gt;at the east end of the passage." source_id="LOC_COBBLE" description_en="You are crawling over cobbles in a low passage.  There is a dim light&#10;at the east end of the passage." description_es="" short_en="You're in cobble crawl." maptag="" chapter_id="CH_ENTRY" source_reference="Open_Adventure.yaml locations/LOC_COBBLE" review_status="ok" role="playable" conditions="LIT=True" objects_here="CAGE">
          <mxCell id="CH_ENTRY_LOC_COBBLE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;arcSize=6;" vertex="1" parent="1">
            <mxGeometry x="1000" y="40" width="260" height="110" as="geometry"/>
          </mxCell>
        </object>
        <object label="&lt;b&gt;LOC_CRACK — The crack is far too small for you to follow.  At...&lt;/b&gt;&lt;br&gt;&lt;br&gt;The crack is far too small for you to follow.  At its widest it is&lt;br&gt;barely wide enough to admit your foot." source_id="LOC_CRACK" description_en="The crack is far too small for you to follow.  At its widest it is&#10;barely wide enough to admit your foot." description_es="" short_en="" maptag="" chapter_id="CH_ENTRY" source_reference="Open_Adventure.yaml locations/LOC_CRACK" review_status="ok" role="transient" conditions="DEEP=True">
