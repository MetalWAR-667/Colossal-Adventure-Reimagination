            <mxGeometry x="1320" y="40" width="260" height="110" as="geometry"/>
          </mxCell>
        </object>
        <object label="&lt;b&gt;LOC_DEBRIS — in debris room&lt;/b&gt;&lt;br&gt;&lt;br&gt;You are in a debris room filled with stuff washed in from the surface.&lt;br&gt;A low wide passage with cobbles becomes plugged with mud and debris&lt;br&gt;here, but an awkward canyon leads upward and west.  In the mud someone&lt;br&gt;[... full description stored in node metadata ...]" source_id="LOC_DEBRIS" description_en="You are in a debris room filled with stuff washed in from the surface.&#10;A low wide passage with cobbles becomes plugged with mud and debris&#10;here, but an awkward canyon leads upward and west.  In the mud someone&#10;has scrawled, &quot;MAGIC WORD XYZZY&quot;." description_es="" short_en="You're in debris room." maptag="" chapter_id="CH_ENTRY" source_reference="Open_Adventure.yaml locations/LOC_DEBRIS" review_status="ok" role="playable" conditions="" objects_here="ROD, OBJ_47" immovable_objects_here="OBJ_47">
