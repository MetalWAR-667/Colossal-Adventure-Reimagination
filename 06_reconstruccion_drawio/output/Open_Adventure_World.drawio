          </mxCell>
        </object>
        <object label="&lt;b&gt;LOC_MIRRORCANYON — in Mirror Canyon&lt;/b&gt;&lt;br&gt;&lt;br&gt;You are in a north/south canyon about 25 feet across.  The floor is&lt;br&gt;covered by white mist seeping in from the north.  The walls extend&lt;br&gt;upward for well over 100 feet.  Suspended from some unseen point far&lt;br&gt;above&lt;br&gt;[... full description stored in node metadata ...]" source_id="LOC_MIRRORCANYON" description_en="You are in a north/south canyon about 25 feet across.  The floor is&#10;covered by white mist seeping in from the north.  The walls extend&#10;upward for well over 100 feet.  Suspended from some unseen point far&#10;above you, an enormous two-sided mirror is hanging parallel to and&#10;midway between the canyon walls.  (The mirror is obviously provided&#10;for the use of the dwarves who, as you know, are extremely vain.)  A&#10;small window can be seen in either wall, some fifty feet up." description_es="" short_en="You're in Mirror Canyon." maptag="" chapter_id="CH_RESERVOIR" source_reference="Open_Adventure.yaml locations/LOC_MIRRORCANYON" review_status="ok" role="playable" conditions="DEEP=True" objects_here="MIRROR" immovable_objects_here="MIRROR" sound="WIND_WHISTLES">
          <mxCell id="CH_RESERVOIR_LOC_MIRRORCANYON" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;arcSize=6;" vertex="1" parent="1">
