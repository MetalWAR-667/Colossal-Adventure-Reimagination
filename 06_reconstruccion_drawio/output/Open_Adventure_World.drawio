          </mxCell>
        </object>
        <object label="&lt;b&gt;LOC_REACHDEAD — Dead end.&lt;/b&gt;&lt;br&gt;&lt;br&gt;You have reached a dead end." source_id="LOC_REACHDEAD" description_en="You have reached a dead end." description_es="" short_en="" maptag="Dead end." chapter_id="CH_RESERVOIR" source_reference="Open_Adventure.yaml locations/LOC_REACHDEAD" review_status="ok" role="playable" conditions="DEEP=True" objects_here="OBJ_69" treasures_here="OBJ_69">
