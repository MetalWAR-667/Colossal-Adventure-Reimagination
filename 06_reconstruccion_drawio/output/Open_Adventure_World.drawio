          </mxCell>
        </object>
        <object label="&lt;b&gt;LOC_LIMESTONE — in limestone passage&lt;/b&gt;&lt;br&gt;&lt;br&gt;You are walking along a gently sloping north/south passage lined with&lt;br&gt;oddly shaped limestone formations." source_id="LOC_LIMESTONE" description_en="You are walking along a gently sloping north/south passage lined with&#10;oddly shaped limestone formations." description_es="" short_en="You're in limestone passage." maptag="" chapter_id="CH_REPOSITORY" source_reference="Open_Adventure.yaml locations/LOC_LIMESTONE" review_status="ok" role="playable" conditions="DEEP=True, NOARRR=True">
          <mxCell id="CH_REPOSITORY_LOC_LIMESTONE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;arcSize=6;" vertex="1" parent="1">
