          </mxCell>
        </object>
        <object label="&lt;b&gt;LOC_CLIFFLEDGE — Clifftop&lt;/b&gt;&lt;br&gt;&lt;br&gt;You are on a small ledge at the top of a nearly vertical cliff.&lt;br&gt;There is a low crawl leading off to the northeast." source_id="LOC_CLIFFLEDGE" description_en="You are on a small ledge at the top of a nearly vertical cliff.&#10;There is a low crawl leading off to the northeast." description_es="" short_en="You're at top of cliff." maptag="Clifftop" chapter_id="CH_RESERVOIR" source_reference="Open_Adventure.yaml locations/LOC_CLIFFLEDGE" review_status="ok" role="playable" conditions="DEEP=True">
          <mxCell id="CH_RESERVOIR_LOC_CLIFFLEDGE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;arcSize=6;" vertex="1" parent="1">
