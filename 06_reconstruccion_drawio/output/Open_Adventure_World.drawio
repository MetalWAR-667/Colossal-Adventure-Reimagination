            <mxGeometry x="1640" y="40" width="260" height="110" as="geometry"/>
          </mxCell>
        </object>
        <object label="&lt;b&gt;LOC_EASTBANK — on east bank of fissure&lt;/b&gt;&lt;br&gt;&lt;br&gt;You are on the east bank of a fissure slicing clear across the hall.&lt;br&gt;The mist is quite thick here, and the fissure is too wide to jump." source_id="LOC_EASTBANK" description_en="You are on the east bank of a fissure slicing clear across the hall.&#10;The mist is quite thick here, and the fissure is too wide to jump." description_es="" short_en="You're on east bank of fissure." maptag="" chapter_id="CH_ENTRY" source_reference="Open_Adventure.yaml locations/LOC_EASTBANK" review_status="ok" role="playable" conditions="DEEP=True" objects_here="FISSURE" immovable_objects_here="FISSURE">
