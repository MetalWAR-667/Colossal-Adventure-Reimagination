          </mxCell>
        </object>
        <object label="&lt;b&gt;LOC_NE — Repository ne end&lt;/b&gt;&lt;br&gt;&lt;br&gt;You are at the northeast end of an immense room, even larger than the&lt;br&gt;Giant Room.  It appears to be a repository for the &amp;quot;Adventure&amp;quot;&lt;br&gt;program.  Massive torches far overhead bathe the room with smoky&lt;br&gt;yellow light&lt;br&gt;[... full description stored in node metadata ...]" source_id="LOC_NE" description_en="You are at the northeast end of an immense room, even larger than the&#10;Giant Room.  It appears to be a repository for the &quot;Adventure&quot;&#10;program.  Massive torches far overhead bathe the room with smoky&#10;yellow light.  Scattered about you can be seen a pile of bottles (all&#10;of them empty), a nursery of young beanstalks murmuring quietly, a bed&#10;of oysters, a bundle of black rods with rusty stars on their ends, and&#10;a collection of brass lanterns.  Off to one side a great many dwarves&#10;are sleeping on the floor, snoring loudly.  A notice nearby reads: &quot;Do&#10;not disturb the dwarves!&quot;  An immense mirror is hanging against one&#10;wall, and stretches to the other end of the room, where various other&#10;sundry objects can be glimpsed dimly in the distance." description_es="" short_en="You're at ne end." maptag="Repository ne end" chapter_id="CH_REPOSITORY" source_reference="Open_Adventure.yaml locations/LOC_NE" review_status="ok" role="playable" conditions="DEEP=True, LIT=True" sound="MURMURING_SNORING">
          <mxCell id="CH_REPOSITORY_LOC_NE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;arcSize=6;" vertex="1" parent="1">
            <mxGeometry x="360" y="200" width="260" height="110" as="geometry"/>
          </mxCell>
        </object>
        <object label="&lt;b&gt;LOC_NECHASM — on ne side of chasm&lt;/b&gt;&lt;br&gt;&lt;br&gt;You are on the far side of the chasm.  A ne path leads away from the&lt;br&gt;chasm on this side." source_id="LOC_NECHASM" description_en="You are on the far side of the chasm.  A ne path leads away from the&#10;chasm on this side." description_es="" short_en="You're on ne side of chasm." maptag="" chapter_id="CH_REPOSITORY" source_reference="Open_Adventure.yaml locations/LOC_NECHASM" review_status="ok" role="playable" conditions="DEEP=True, NOARRR=True" objects_here="CHASM, TROLL" immovable_objects_here="CHASM, TROLL">
