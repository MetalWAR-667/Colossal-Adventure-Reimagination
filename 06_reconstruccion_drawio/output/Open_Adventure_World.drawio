        <object label="&lt;b&gt;LOC_FLOORHOLE — Floor hole.&lt;/b&gt;&lt;br&gt;&lt;br&gt;You are in a low n/s passage at a hole in the floor.  The hole goes&lt;br&gt;down to an e/w passage." source_id="LOC_FLOORHOLE" description_en="You are in a low n/s passage at a hole in the floor.  The hole goes&#10;down to an e/w passage." description_es="" short_en="You're in n/s passage above e/w passage." maptag="Floor hole." chapter_id="CH_CENTRAL" source_reference="Open_Adventure.yaml locations/LOC_FLOORHOLE" review_status="ok" role="playable" conditions="DEEP=True" objects_here="OBJ_52" treasures_here="OBJ_52">
