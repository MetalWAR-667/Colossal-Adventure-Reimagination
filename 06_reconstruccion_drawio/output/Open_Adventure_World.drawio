        <object label="&lt;b&gt;LOC_FOOF1 — &amp;gt;&amp;gt;Foof!&amp;lt;&amp;lt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;gt;&amp;gt;Foof!&amp;lt;&amp;lt;" source_id="LOC_FOOF1" description_en="&gt;&gt;Foof!&lt;&lt;" description_es="" short_en="" maptag="" chapter_id="CH_ENTRY" source_reference="Open_Adventure.yaml locations/LOC_FOOF1" review_status="ok" role="special" conditions="">
