        <object label="&lt;b&gt;LOC_MISTHALL — in Hall of Mists&lt;/b&gt;&lt;br&gt;&lt;br&gt;You are at one end of a vast hall stretching forward out of sight to&lt;br&gt;the west.  There are openings to either side.  Nearby, a wide stone&lt;br&gt;staircase leads downward.  The hall is filled with wisps of white mist&lt;br&gt;sw&lt;br&gt;[... full description stored in node metadata ...]" source_id="LOC_MISTHALL" description_en="You are at one end of a vast hall stretching forward out of sight to&#10;the west.  There are openings to either side.  Nearby, a wide stone&#10;staircase leads downward.  The hall is filled with wisps of white mist&#10;swaying to and fro almost as if alive.  A cold wind blows up the&#10;staircase.  There is a passage at the top of a dome behind you." description_es="" short_en="You're in Hall of Mists." maptag="" chapter_id="CH_ENTRY" source_reference="Open_Adventure.yaml locations/LOC_MISTHALL" review_status="ok" role="playable" conditions="DEEP=True" objects_here="STEPS" immovable_objects_here="STEPS" sound="WIND_WHISTLES">
          <mxCell id="CH_ENTRY_LOC_MISTHALL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;arcSize=6;" vertex="1" parent="1">
            <mxGeometry x="680" y="200" width="260" height="110" as="geometry"/>
          </mxCell>
        </object>
        <object label="&lt;b&gt;LOC_NUGGET — in nugget-of-gold room&lt;/b&gt;&lt;br&gt;&lt;br&gt;This is a low room with a crude note on the wall.  The note says,&lt;br&gt;&amp;quot;You won&amp;#x27;t get it up the steps&amp;quot;." source_id="LOC_NUGGET" description_en="This is a low room with a crude note on the wall.  The note says,&#10;&quot;You won't get it up the steps&quot;." description_es="" short_en="You're in nugget-of-gold room." maptag="" chapter_id="CH_ENTRY" source_reference="Open_Adventure.yaml locations/LOC_NUGGET" review_status="ok" role="playable" conditions="DEEP=True" objects_here="OBJ_48, NUGGET" treasures_here="NUGGET" immovable_objects_here="OBJ_48">
