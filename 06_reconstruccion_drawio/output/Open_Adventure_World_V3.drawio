        <object id="N_LOC_JUMBLE" label="&lt;b&gt;LOC_JUMBLE — Rock jumble&lt;/b&gt;&lt;hr size='1'/&gt;You are in a jumble of rock, with cracks everywhere.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXITS (source precedence order)&lt;/b&gt;&lt;br&gt;1. DOWN, Y2 → LOC_Y2&lt;br&gt;2. UPWAR → LOC_MISTHALL [Ch 02]" source_id="LOC_JUMBLE" description_en="You are in a jumble of rock, with cracks everywhere." description_es="" short_en="" maptag="Rock jumble" chapter_id="CH_Y2_WINDOWS" source_reference="Open_Adventure.yaml locations/LOC_JUMBLE" review_status="ok" role="playable" conditions="DEEP=True" travel_rules="[{&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_Y2&quot;], &quot;action_target&quot;: &quot;LOC_Y2&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;DOWN&quot;, &quot;Y2&quot;]}, {&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_MISTHALL&quot;], &quot;action_target&quot;: &quot;LOC_MISTHALL&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;UPWAR&quot;]}]">
