        <object id="N_LOC_ROADEND" label="&lt;b&gt;LOC_ROADEND — at end of road&lt;/b&gt;&lt;hr size='1'/&gt;The road, which approaches from the east, ends here amid the trees.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXITS (source precedence order)&lt;/b&gt;&lt;br&gt;1. ROAD, EAST, UPWAR → LOC_HILL&lt;br&gt;2. BUILD → LOC_START&lt;br&gt;3. SOUTH, FORES → LOC_FOREST14&lt;br&gt;4. WEST → LOC_FOREST15&lt;br&gt;5. NORTH → LOC_FOREST21" source_id="LOC_ROADEND" description_en="The road, which approaches from the east, ends here amid the trees." description_es="" short_en="You're at end of road." maptag="" chapter_id="CH_SURFACE" source_reference="Open_Adventure.yaml locations/LOC_ROADEND" review_status="ok" role="playable" conditions="ABOVE=True, LIT=True" travel_rules="[{&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_HILL&quot;], &quot;action_target&quot;: &quot;LOC_HILL&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;ROAD&quot;, &quot;EAST&quot;, &quot;UPWAR&quot;]}, {&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_START&quot;], &quot;action_target&quot;: &quot;LOC_START&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;BUILD&quot;]}, {&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_FOREST14&quot;], &quot;action_target&quot;: &quot;LOC_FOREST14&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;SOUTH&quot;, &quot;FORES&quot;]}, {&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_FOREST15&quot;], &quot;action_target&quot;: &quot;LOC_FOREST15&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;WEST&quot;]}, {&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_FOREST21&quot;], &quot;action_target&quot;: &quot;LOC_FOREST21&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;NORTH&quot;]}]">
