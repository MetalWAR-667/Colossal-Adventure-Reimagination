        <object id="N_LOC_WINDING" label="&lt;b&gt;LOC_WINDING — in sloping corridor&lt;/b&gt;&lt;hr size='1'/&gt;You are in a long winding corridor sloping out of sight in both&lt;br&gt;directions.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXITS (source precedence order)&lt;/b&gt;&lt;br&gt;1. DOWN → LOC_LOWROOM [Ch 05]&lt;br&gt;2. UPWAR → LOC_SWCHASM" source_id="LOC_WINDING" description_en="You are in a long winding corridor sloping out of sight in both&#10;directions." description_es="" short_en="You're in sloping corridor." maptag="" chapter_id="CH_REPOSITORY" source_reference="Open_Adventure.yaml locations/LOC_WINDING" review_status="ok" role="playable" conditions="DEEP=True" travel_rules="[{&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_LOWROOM&quot;], &quot;action_target&quot;: &quot;LOC_LOWROOM&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;DOWN&quot;]}, {&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_SWCHASM&quot;], &quot;action_target&quot;: &quot;LOC_SWCHASM&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;UPWAR&quot;]}]">
