        <object id="N_LOC_SLOPING1" label="&lt;b&gt;LOC_SLOPING1 — Sloping corridor&lt;/b&gt;&lt;hr size='1'/&gt;You are in a long sloping corridor with ragged sharp walls.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXITS (source precedence order)&lt;/b&gt;&lt;br&gt;1. UPWAR, SHELL → LOC_SHELLROOM&lt;br&gt;2. DOWN → LOC_CULDESAC" source_id="LOC_SLOPING1" description_en="You are in a long sloping corridor with ragged sharp walls." description_es="" short_en="" maptag="Sloping corridor" chapter_id="CH_ORIENTAL_PLOVER" source_reference="Open_Adventure.yaml locations/LOC_SLOPING1" review_status="ok" role="playable" conditions="DEEP=True" travel_rules="[{&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_SHELLROOM&quot;], &quot;action_target&quot;: &quot;LOC_SHELLROOM&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;UPWAR&quot;, &quot;SHELL&quot;]}, {&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_CULDESAC&quot;], &quot;action_target&quot;: &quot;LOC_CULDESAC&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;DOWN&quot;]}]">
