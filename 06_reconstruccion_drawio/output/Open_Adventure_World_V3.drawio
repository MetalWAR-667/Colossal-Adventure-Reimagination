        <object id="N_LOC_BROKEN" label="&lt;b&gt;LOC_BROKEN — in dirty passage&lt;/b&gt;&lt;hr size='1'/&gt;You are in a dirty broken passage.  To the east is a crawl.  To the&lt;br&gt;west is a large passage.  Above you is a hole to another passage.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXITS (source precedence order)&lt;/b&gt;&lt;br&gt;1. EAST, CRAWL → LOC_SMALLPITBRINK&lt;br&gt;2. UPWAR, HOLE → LOC_FLOORHOLE [Ch 03]&lt;br&gt;3. WEST → LOC_DUSTY&lt;br&gt;4. BEDQU → LOC_BEDQUILT [Ch 05]" source_id="LOC_BROKEN" description_en="You are in a dirty broken passage.  To the east is a crawl.  To the&#10;west is a large passage.  Above you is a hole to another passage." description_es="" short_en="You're in dirty passage." maptag="" chapter_id="CH_Y2_WINDOWS" source_reference="Open_Adventure.yaml locations/LOC_BROKEN" review_status="ok" role="playable" conditions="DEEP=True" travel_rules="[{&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_SMALLPITBRINK&quot;], &quot;action_target&quot;: &quot;LOC_SMALLPITBRINK&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;EAST&quot;, &quot;CRAWL&quot;]}, {&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_FLOORHOLE&quot;], &quot;action_target&quot;: &quot;LOC_FLOORHOLE&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;UPWAR&quot;, &quot;HOLE&quot;]}, {&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_DUSTY&quot;], &quot;action_target&quot;: &quot;LOC_DUSTY&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;WEST&quot;]}, {&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_BEDQUILT&quot;], &quot;action_target&quot;: &quot;LOC_BEDQUILT&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;BEDQU&quot;]}]">
