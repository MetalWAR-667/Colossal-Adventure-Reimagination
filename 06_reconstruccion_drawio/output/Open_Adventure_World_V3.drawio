        <object id="N_LOC_STEEP" label="&lt;b&gt;LOC_STEEP — Steep incline&lt;/b&gt;&lt;hr size='1'/&gt;You are on a very steep incline, which widens at it goes upward.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXITS (source precedence order)&lt;/b&gt;&lt;br&gt;1. DOWN, SE → LOC_TREACHEROUS&lt;br&gt;2. UPWAR, NW → LOC_CLIFFBASE" source_id="LOC_STEEP" description_en="You are on a very steep incline, which widens at it goes upward." description_es="" short_en="" maptag="Steep incline" chapter_id="CH_RESERVOIR" source_reference="Open_Adventure.yaml locations/LOC_STEEP" review_status="ok" role="playable" conditions="DEEP=True" travel_rules="[{&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_TREACHEROUS&quot;], &quot;action_target&quot;: &quot;LOC_TREACHEROUS&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;DOWN&quot;, &quot;SE&quot;]}, {&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_CLIFFBASE&quot;], &quot;action_target&quot;: &quot;LOC_CLIFFBASE&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;UPWAR&quot;, &quot;NW&quot;]}]">
