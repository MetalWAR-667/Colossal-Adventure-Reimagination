        <object id="N_LOC_WATERFALL" label="&lt;b&gt;LOC_WATERFALL — in cavern with waterfall&lt;/b&gt;&lt;hr size='1'/&gt;You are in a magnificent cavern with a rushing stream, which cascades&lt;br&gt;over a sparkling waterfall into a roaring whirlpool which disappears&lt;br&gt;through a hole in the floor.  Passages exit to the south and west.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXITS (source precedence order)&lt;/b&gt;&lt;br&gt;1. SOUTH, OUT → LOC_IMMENSE&lt;br&gt;2. GIANT → LOC_GIANTROOM&lt;br&gt;3. WEST → LOC_INCLINE [Ch 06]" source_id="LOC_WATERFALL" description_en="You are in a magnificent cavern with a rushing stream, which cascades&#10;over a sparkling waterfall into a roaring whirlpool which disappears&#10;through a hole in the floor.  Passages exit to the south and west." description_es="" short_en="You're in cavern with waterfall." maptag="" chapter_id="CH_CENTRAL" source_reference="Open_Adventure.yaml locations/LOC_WATERFALL" review_status="ok" role="playable" conditions="DEEP=True, FLUID=True" travel_rules="[{&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_IMMENSE&quot;], &quot;action_target&quot;: &quot;LOC_IMMENSE&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;SOUTH&quot;, &quot;OUT&quot;]}, {&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_GIANTROOM&quot;], &quot;action_target&quot;: &quot;LOC_GIANTROOM&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;GIANT&quot;]}, {&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_INCLINE&quot;], &quot;action_target&quot;: &quot;LOC_INCLINE&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;WEST&quot;]}]" objects_here="TRIDENT" treasures_here="TRIDENT" sound="STREAM_SPLASHES">
