        <object id="N_LOC_ORIENTAL" label="&lt;b&gt;LOC_ORIENTAL — in Oriental Room&lt;/b&gt;&lt;hr size='1'/&gt;This is the Oriental Room.  Ancient oriental cave drawings cover the&lt;br&gt;walls.  A gently sloping passage leads upward to the north, another&lt;br&gt;passage leads se, and a hands and knees crawl leads west.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXITS (source precedence order)&lt;/b&gt;&lt;br&gt;1. SE → LOC_SWISSCHEESE [Ch 05]&lt;br&gt;2. WEST, CRAWL → LOC_LOWROOM [Ch 05]&lt;br&gt;3. UPWAR, NORTH, CAVER → LOC_MISTY" source_id="LOC_ORIENTAL" description_en="This is the Oriental Room.  Ancient oriental cave drawings cover the&#10;walls.  A gently sloping passage leads upward to the north, another&#10;passage leads se, and a hands and knees crawl leads west." description_es="" short_en="You're in Oriental Room." maptag="" chapter_id="CH_ORIENTAL_PLOVER" source_reference="Open_Adventure.yaml locations/LOC_ORIENTAL" review_status="ok" role="playable" conditions="DEEP=True" travel_rules="[{&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_SWISSCHEESE&quot;], &quot;action_target&quot;: &quot;LOC_SWISSCHEESE&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;SE&quot;]}, {&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_LOWROOM&quot;], &quot;action_target&quot;: &quot;LOC_LOWROOM&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;WEST&quot;, &quot;CRAWL&quot;]}, {&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_MISTY&quot;], &quot;action_target&quot;: &quot;LOC_MISTY&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;UPWAR&quot;, &quot;NORTH&quot;, &quot;CAVER&quot;]}]" objects_here="OBJ_29, VASE" treasures_here="VASE" immovable_objects_here="OBJ_29">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;arcSize=4;fontSize=10;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1">
