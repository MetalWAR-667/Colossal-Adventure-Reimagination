        <object id="N_LOC_AWKWARD" label="&lt;b&gt;LOC_AWKWARD — Awkward canyon&lt;/b&gt;&lt;hr size='1'/&gt;You are in an awkward sloping east/west canyon.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXITS (source precedence order)&lt;/b&gt;&lt;br&gt;1. DEPRE → LOC_GRATE [Ch 01] [not GRATE=GRATE_CLOSED]&lt;br&gt;2. ENTRA → LOC_BELOWGRATE&lt;br&gt;3. DOWN, EAST, DEBRI → LOC_DEBRIS&lt;br&gt;4. INWAR, UPWAR, WEST → LOC_BIRDCHAMBER&lt;br&gt;5. PIT → LOC_PITTOP" source_id="LOC_AWKWARD" description_en="You are in an awkward sloping east/west canyon." description_es="" short_en="" maptag="Awkward canyon." chapter_id="CH_ENTRY" source_reference="Open_Adventure.yaml locations/LOC_AWKWARD" review_status="ok" role="playable" conditions="" travel_rules="[{&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_GRATE&quot;], &quot;action_target&quot;: &quot;LOC_GRATE&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: {&quot;object&quot;: &quot;GRATE&quot;, &quot;state&quot;: &quot;GRATE_CLOSED&quot;, &quot;type&quot;: &quot;not&quot;}, &quot;verbs&quot;: [&quot;DEPRE&quot;]}, {&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_BELOWGRATE&quot;], &quot;action_target&quot;: &quot;LOC_BELOWGRATE&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;ENTRA&quot;]}, {&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_DEBRIS&quot;], &quot;action_target&quot;: &quot;LOC_DEBRIS&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;DOWN&quot;, &quot;EAST&quot;, &quot;DEBRI&quot;]}, {&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_BIRDCHAMBER&quot;], &quot;action_target&quot;: &quot;LOC_BIRDCHAMBER&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;INWAR&quot;, &quot;UPWAR&quot;, &quot;WEST&quot;]}, {&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_PITTOP&quot;], &quot;action_target&quot;: &quot;LOC_PITTOP&quot;, &quot;action_type&quo