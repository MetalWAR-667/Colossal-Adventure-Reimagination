        <object id="N_LOC_BELOWGRATE" label="&lt;b&gt;LOC_BELOWGRATE — below the grate&lt;/b&gt;&lt;hr size='1'/&gt;You are in a small chamber beneath a 3x3 steel grate to the surface.&lt;br&gt;A low crawl over cobbles leads inward to the west.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXITS (source precedence order)&lt;/b&gt;&lt;br&gt;1. OUT, UPWAR → LOC_GRATE [Ch 01] [not GRATE=GRATE_CLOSED]&lt;br&gt;2. OUT ✕ msg GRATE_NOWAY&lt;br&gt;3. CRAWL, COBBL, INWAR, WEST → LOC_COBBLE&lt;br&gt;4. PIT → LOC_PITTOP&lt;br&gt;5. DEBRI → LOC_DEBRIS" source_id="LOC_BELOWGRATE" description_en="You are in a small chamber beneath a 3x3 steel grate to the surface.&#10;A low crawl over cobbles leads inward to the west." description_es="" short_en="You're below the grate." maptag="" chapter_id="CH_ENTRY" source_reference="Open_Adventure.yaml locations/LOC_BELOWGRATE" review_status="ok" role="playable" conditions="LIT=True" travel_rules="[{&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_GRATE&quot;], &quot;action_target&quot;: &quot;LOC_GRATE&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: {&quot;object&quot;: &quot;GRATE&quot;, &quot;state&quot;: &quot;GRATE_CLOSED&quot;, &quot;type&quot;: &quot;not&quot;}, &quot;verbs&quot;: [&quot;OUT&quot;, &quot;UPWAR&quot;]}, {&quot;action_full&quot;: [&quot;speak&quot;, &quot;GRATE_NOWAY&quot;], &quot;action_target&quot;: &quot;GRATE_NOWAY&quot;, &quot;action_type&quot;: &quot;speak&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;OUT&quot;]}, {&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_COBBLE&quot;], &quot;action_target&quot;: &quot;LOC_COBBLE&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;CRAWL&quot;, &quot;COBBL&quot;, &quot;INWAR&quot;, &quot;WEST&quot;]}, {&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_PITTOP&quot;], &quot;action_target&quot;: &quot;LOC_PITTOP&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;PIT&quot;]}, {&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_DEBRIS&quot;], &quot;action_target&quot;: &quot;LOC_DEBRIS&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;DEBRI&quot;]}]" blocked_messages="OUT → GRATE_NOWAY" objects_here="GRATE" immovable_objects_here="GRATE">
