        <object id="N_LOC_DUSTY" label="&lt;b&gt;LOC_DUSTY — in dusty rock room&lt;/b&gt;&lt;hr size='1'/&gt;You are in a large room full of dusty rocks.  There is a big hole in&lt;br&gt;the floor.  There are cracks everywhere, and a passage leading east.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXITS (source precedence order)&lt;/b&gt;&lt;br&gt;1. EAST, PASSA → LOC_BROKEN&lt;br&gt;2. DOWN, HOLE, FLOOR → LOC_COMPLEX [Ch 05]&lt;br&gt;3. BEDQU → LOC_BEDQUILT [Ch 05]" source_id="LOC_DUSTY" description_en="You are in a large room full of dusty rocks.  There is a big hole in&#10;the floor.  There are cracks everywhere, and a passage leading east." description_es="" short_en="You're in dusty rock room." maptag="" chapter_id="CH_Y2_WINDOWS" source_reference="Open_Adventure.yaml locations/LOC_DUSTY" review_status="ok" role="playable" conditions="DEEP=True" travel_rules="[{&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_BROKEN&quot;], &quot;action_target&quot;: &quot;LOC_BROKEN&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;EAST&quot;, &quot;PASSA&quot;]}, {&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_COMPLEX&quot;], &quot;action_target&quot;: &quot;LOC_COMPLEX&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;DOWN&quot;, &quot;HOLE&quot;, &quot;FLOOR&quot;]}, {&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_BEDQUILT&quot;], &quot;action_target&quot;: &quot;LOC_BEDQUILT&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;BEDQU&quot;]}]">
