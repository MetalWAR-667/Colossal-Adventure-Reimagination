        <object id="N_LOC_BUILDING" label="&lt;b&gt;LOC_BUILDING — inside building&lt;/b&gt;&lt;hr size='1'/&gt;You are inside a building, a well house for a large spring.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXITS (source precedence order)&lt;/b&gt;&lt;br&gt;1. OUT, OUTDO, WEST → LOC_START&lt;br&gt;2. XYZZY → LOC_FOOF1 [Ch 02]&lt;br&gt;3. PLUGH → LOC_FOOF3 [Ch 10]&lt;br&gt;4. DOWNS, STREA → LOC_SEWER" source_id="LOC_BUILDING" description_en="You are inside a building, a well house for a large spring." description_es="" short_en="You're inside building." maptag="" chapter_id="CH_SURFACE" source_reference="Open_Adventure.yaml locations/LOC_BUILDING" review_status="ok" role="playable" conditions="ABOVE=True, FLUID=True, LIT=True" travel_rules="[{&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_START&quot;], &quot;action_target&quot;: &quot;LOC_START&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;OUT&quot;, &quot;OUTDO&quot;, &quot;WEST&quot;]}, {&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_FOOF1&quot;], &quot;action_target&quot;: &quot;LOC_FOOF1&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;XYZZY&quot;]}, {&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_FOOF3&quot;], &quot;action_target&quot;: &quot;LOC_FOOF3&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;PLUGH&quot;]}, {&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_SEWER&quot;], &quot;action_target&quot;: &quot;LOC_SEWER&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;DOWNS&quot;, &quot;STREA&quot;]}]" objects_here="KEYS, LAMP, FOOD, BOTTLE" sound="STREAM_GURGLES">
