        <object id="N_LOC_PLOVER" label="&lt;b&gt;LOC_PLOVER — in Plover Room&lt;/b&gt;&lt;hr size='1'/&gt;You&amp;#x27;re in a small chamber lit by an eerie green light.  An extremely&lt;br&gt;narrow tunnel exits to the west.  A dark corridor leads ne.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXITS (source precedence order)&lt;/b&gt;&lt;br&gt;1. WEST, PASSA, OUT ⚡ special(1)&lt;br&gt;2. WEST → LOC_ALCOVE&lt;br&gt;3. PLOVE ⚡ special(2) [carry EMERALD]&lt;br&gt;4. PLOVE → LOC_FOOF6 [Ch 10]&lt;br&gt;5. NE, DARK → LOC_DARKROOM" source_id="LOC_PLOVER" description_en="You're in a small chamber lit by an eerie green light.  An extremely&#10;narrow tunnel exits to the west.  A dark corridor leads ne." description_es="" short_en="You're in Plover Room." maptag="" chapter_id="CH_ORIENTAL_PLOVER" source_reference="Open_Adventure.yaml locations/LOC_PLOVER" review_status="ok" role="playable" conditions="DEEP=True, LIT=True" travel_rules="[{&quot;action_full&quot;: [&quot;special&quot;, &quot;1&quot;], &quot;action_target&quot;: &quot;1&quot;, &quot;action_type&quot;: &quot;special&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;WEST&quot;, &quot;PASSA&quot;, &quot;OUT&quot;]}, {&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_ALCOVE&quot;], &quot;action_target&quot;: &quot;LOC_ALCOVE&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;WEST&quot;]}, {&quot;action_full&quot;: [&quot;special&quot;, &quot;2&quot;], &quot;action_target&quot;: &quot;2&quot;, &quot;action_type&quot;: &quot;special&quot;, &quot;cond&quot;: {&quot;object&quot;: &quot;EMERALD&quot;, &quot;type&quot;: &quot;carry&quot;}, &quot;verbs&quot;: [&quot;PLOVE&quot;]}, {&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_FOOF6&quot;], &quot;action_target&quot;: &quot;LOC_FOOF6&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;PLOVE&quot;]}, {&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_DARKROOM&quot;], &q