        <object id="N_LOC_SECRET2" label="&lt;b&gt;LOC_SECRET2 — Secret canyon&lt;/b&gt;&lt;hr size='1'/&gt;You are in a secret n/s canyon above a sizable passage.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXITS (source precedence order)&lt;/b&gt;&lt;br&gt;1. NORTH → LOC_THREEJUNCTION&lt;br&gt;2. DOWN, PASSA → LOC_BEDQUILT&lt;br&gt;3. SOUTH → LOC_TOPSTALACTITE [Ch 04]" source_id="LOC_SECRET2" description_en="You are in a secret n/s canyon above a sizable passage." description_es="" short_en="" maptag="Secret canyon" chapter_id="CH_BEDQUILT" source_reference="Open_Adventure.yaml locations/LOC_SECRET2" review_status="ok" role="playable" conditions="DEEP=True" travel_rules="[{&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_THREEJUNCTION&quot;], &quot;action_target&quot;: &quot;LOC_THREEJUNCTION&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;NORTH&quot;]}, {&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_BEDQUILT&quot;], &quot;action_target&quot;: &quot;LOC_BEDQUILT&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;DOWN&quot;, &quot;PASSA&quot;]}, {&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_TOPSTALACTITE&quot;], &quot;action_target&quot;: &quot;LOC_TOPSTALACTITE&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;SOUTH&quot;]}]">
