        <object id="N_LOC_BARRENFRONT" label="&lt;b&gt;LOC_BARRENFRONT — in front of Barren Room&lt;/b&gt;&lt;hr size='1'/&gt;You are standing at the entrance to a large, barren room.  A notice&lt;br&gt;above the entrance reads:  &amp;quot;Caution!  Bear in room!&amp;quot;&lt;br&gt;&lt;br&gt;&lt;b&gt;EXITS (source precedence order)&lt;/b&gt;&lt;br&gt;1. WEST, UPWAR → LOC_LIMESTONE&lt;br&gt;2. FORK → LOC_FORK&lt;br&gt;3. EAST, INWAR, BARRE, ENTER → LOC_BARRENROOM&lt;br&gt;4. VIEW → LOC_BREATHTAKING" source_id="LOC_BARRENFRONT" description_en="You are standing at the entrance to a large, barren room.  A notice&#10;above the entrance reads:  &quot;Caution!  Bear in room!&quot;" description_es="" short_en="You're in front of Barren Room." maptag="" chapter_id="CH_REPOSITORY" source_reference="Open_Adventure.yaml locations/LOC_BARRENFRONT" review_status="ok" role="playable" conditions="DEEP=True, NOARRR=True" travel_rules="[{&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_LIMESTONE&quot;], &quot;action_target&quot;: &quot;LOC_LIMESTONE&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;WEST&quot;, &quot;UPWAR&quot;]}, {&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_FORK&quot;], &quot;action_target&quot;: &quot;LOC_FORK&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;FORK&quot;]}, {&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_BARRENROOM&quot;], &quot;action_target&quot;: &quot;LOC_BARRENROOM&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;EAST&quot;, &quot;INWAR&quot;, &quot;BARRE&quot;, &quot;ENTER&quot;]}, {&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_BREATHTAKING&quot;], &quot;action_target&quot;: &quot;LOC_BREATHTAKING&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;VIEW&quot;]}]">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;arcSize=4;fontSize=10;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1">
            <mxGeometry x="1720" y="2040" width="290" height="200" as="geometry" />
          </mxCell>
        </object>
        <object id="N_LOC_BARRENROOM" label="&lt;b&gt;LOC_BARRENROOM — in Barren Room&lt;/b&gt;&lt;hr size='1'/&gt;You are inside a barren room.  The center of the room is completely&lt;br&gt;empty except for some dust.  Marks in the dust lead away toward the&lt;br&gt;far end of the room.  The only exit is the way you came in.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXITS (source precedence order)&lt;/b&gt;&lt;br&gt;1. WEST, OUT → LOC_BARRENFRONT&lt;br&gt;2. FORK → LOC_FORK&lt;br&gt;3. VIEW → LOC_BREATHTAKING" source_id="LOC_BARRENROOM" description_en="You are inside a barren room.  The center of the room is completely&#10;empty except for some dust.  Marks in the dust lead away toward the&#10;far end of the room.  The only exit is the way you came in." description_es="" short_en="You're in Barren Room." maptag="" chapter_id="CH_REPOSITORY" source_reference="Open_Adventure.yaml locations/LOC_BARRENROOM" review_status="ok" role="playable" conditions="DEEP=True, NOARRR=True" travel_rules="[{&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_BARRENFRONT&quot;], &quot;action_target&quot;: &quot;LOC_BARRENFRONT&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;WEST&quot;, &quot;OUT&quot;]}, {&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_FORK&quot;], &quot;action_target&quot;: &quot;LOC_FORK&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;FORK&quot;]}, {&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_BREATHTAKING&quot;], &quot;action_target&quot;: &quot;LOC_BREATHTAKING&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;VIEW&quot;]}]" objects_here="BEAR, CHAIN" treasures_here="CHAIN" immovable_objects_here="BEAR, CHAIN">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;arcSize=4;fontSize=10;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1">
