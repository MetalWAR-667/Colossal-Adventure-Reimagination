        <object id="N_LOC_TREACHEROUS" label="&lt;b&gt;LOC_TREACHEROUS — Rocky passage&lt;/b&gt;&lt;hr size='1'/&gt;You are scrambling along a treacherously steep, rocky passage.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXITS (source precedence order)&lt;/b&gt;&lt;br&gt;1. UPWAR, NW → LOC_STEEP&lt;br&gt;2. DOWN, SE → LOC_RESNORTH" source_id="LOC_TREACHEROUS" description_en="You are scrambling along a treacherously steep, rocky passage." description_es="" short_en="" maptag="Rocky passage." chapter_id="CH_RESERVOIR" source_reference="Open_Adventure.yaml locations/LOC_TREACHEROUS" review_status="ok" role="playable" conditions="DEEP=True" travel_rules="[{&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_STEEP&quot;], &quot;action_target&quot;: &quot;LOC_STEEP&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;UPWAR&quot;, &quot;NW&quot;]}, {&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_RESNORTH&quot;], &quot;action_target&quot;: &quot;LOC_RESNORTH&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;DOWN&quot;, &quot;SE&quot;]}]">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;arcSize=4;fontSize=10;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1">
