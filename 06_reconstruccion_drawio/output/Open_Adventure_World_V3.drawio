        <object id="N_LOC_IMMENSE" label="&lt;b&gt;LOC_IMMENSE — Immense passage end&lt;/b&gt;&lt;hr size='1'/&gt;You are at one end of an immense north/south passage.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXITS (source precedence order)&lt;/b&gt;&lt;br&gt;1. SOUTH, GIANT, PASSA → LOC_GIANTROOM&lt;br&gt;2. NORTH, ENTER, CAVER → LOC_WATERFALL [not DOOR=DOOR_RUSTED]&lt;br&gt;3. NORTH ✕ msg RUSTY_DOOR" source_id="LOC_IMMENSE" description_en="You are at one end of an immense north/south passage." description_es="" short_en="" maptag="Immense passage end." chapter_id="CH_CENTRAL" source_reference="Open_Adventure.yaml locations/LOC_IMMENSE" review_status="ok" role="playable" conditions="DEEP=True" travel_rules="[{&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_GIANTROOM&quot;], &quot;action_target&quot;: &quot;LOC_GIANTROOM&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;SOUTH&quot;, &quot;GIANT&quot;, &quot;PASSA&quot;]}, {&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_WATERFALL&quot;], &quot;action_target&quot;: &quot;LOC_WATERFALL&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: {&quot;object&quot;: &quot;DOOR&quot;, &quot;state&quot;: &quot;DOOR_RUSTED&quot;, &quot;type&quot;: &quot;not&quot;}, &quot;verbs&quot;: [&quot;NORTH&quot;, &quot;ENTER&quot;, &quot;CAVER&quot;]}, {&quot;action_full&quot;: [&quot;speak&quot;, &quot;RUSTY_DOOR&quot;], &quot;action_target&quot;: &quot;RUSTY_DOOR&quot;, &quot;action_type&quot;: &quot;speak&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;NORTH&quot;]}]" blocked_messages="NORTH → RUSTY_DOOR" objects_here="DOOR" immovable_objects_here="DOOR" sound="WIND_WHISTLES">
