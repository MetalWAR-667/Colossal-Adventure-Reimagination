        <object id="N_LOC_WESTEND" label="&lt;b&gt;LOC_WESTEND — at west end of Twopit Room&lt;/b&gt;&lt;hr size='1'/&gt;You are at the west end of the Twopit Room.  There is a large hole in&lt;br&gt;the wall above the pit at this end of the room.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXITS (source precedence order)&lt;/b&gt;&lt;br&gt;1. EAST, ACROS → LOC_EASTEND&lt;br&gt;2. WEST, SLAB → LOC_SLAB [Ch 05]&lt;br&gt;3. DOWN, PIT → LOC_WESTPIT&lt;br&gt;4. HOLE ✕ msg TOO_FAR" source_id="LOC_WESTEND" description_en="You are at the west end of the Twopit Room.  There is a large hole in&#10;the wall above the pit at this end of the room." description_es="" short_en="You're at west end of Twopit Room." maptag="" chapter_id="CH_CENTRAL" source_reference="Open_Adventure.yaml locations/LOC_WESTEND" review_status="ok" role="playable" conditions="DEEP=True" travel_rules="[{&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_EASTEND&quot;], &quot;action_target&quot;: &quot;LOC_EASTEND&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;EAST&quot;, &quot;ACROS&quot;]}, {&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_SLAB&quot;], &quot;action_target&quot;: &quot;LOC_SLAB&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;WEST&quot;, &quot;SLAB&quot;]}, {&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_WESTPIT&quot;], &quot;action_target&quot;: &quot;LOC_WESTPIT&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;DOWN&quot;, &quot;PIT&quot;]}, {&quot;action_full&quot;: [&quot;speak&quot;, &quot;TOO_FAR&quot;], &quot;action_target&quot;: &quot;TOO_FAR&quot;, &quot;action_type&quot;: &quot;speak&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;HOLE&quot;]}]" blocked_messages="HOLE → TOO_FAR" objects_here="PLANT2" immovable_objects_here="PLANT2">
