        <object id="N_LOC_SMALLPITBRINK" label="&lt;b&gt;LOC_SMALLPITBRINK — at brink of small pit&lt;/b&gt;&lt;hr size='1'/&gt;You are on the brink of a small clean climbable pit.  A crawl leads&lt;br&gt;west.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXITS (source precedence order)&lt;/b&gt;&lt;br&gt;1. WEST, CRAWL → LOC_BROKEN&lt;br&gt;2. DOWN, PIT, CLIMB → LOC_SMALLPIT" source_id="LOC_SMALLPITBRINK" description_en="You are on the brink of a small clean climbable pit.  A crawl leads&#10;west." description_es="" short_en="You're at brink of small pit." maptag="" chapter_id="CH_Y2_WINDOWS" source_reference="Open_Adventure.yaml locations/LOC_SMALLPITBRINK" review_status="ok" role="playable" conditions="DEEP=True" travel_rules="[{&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_BROKEN&quot;], &quot;action_target&quot;: &quot;LOC_BROKEN&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;WEST&quot;, &quot;CRAWL&quot;]}, {&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_SMALLPIT&quot;], &quot;action_target&quot;: &quot;LOC_SMALLPIT&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;DOWN&quot;, &quot;PIT&quot;, &quot;CLIMB&quot;]}]">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;arcSize=4;fontSize=10;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1">
            <mxGeometry x="900" y="740" width="290" height="150" as="geometry" />
          </mxCell>
        </object>
        <object id="N_LOC_WINDOW1" label="&lt;b&gt;LOC_WINDOW1 — at window on pit&lt;/b&gt;&lt;hr size='1'/&gt;You&amp;#x27;re at a low window overlooking a huge pit, which extends up out of&lt;br&gt;sight.  A floor is indistinctly visible over 50 feet below.  Traces of&lt;br&gt;white mist cover the floor of the pit, becoming thicker to the right.&lt;br&gt;Marks in the dust around the window would seem to indicate that&lt;br&gt;someone has been here recently.  Directly across the pit from you and&lt;br&gt;25 feet away there is a similar window looking into a lighted room.  A&lt;br&gt;shadowy figure can be seen there peering back at you.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXITS (source precedence order)&lt;/b&gt;&lt;br&gt;1. EAST, Y2 → LOC_Y2&lt;br&gt;2. JUMP → LOC_NECKBROKE [Ch 11]" source_id="LOC_WINDOW1" description_en="You're at a low window overlooking a huge pit, which extends up out of&#10;sight.  A floor is indistinctly visible over 50 feet below.  Traces of&#10;white mist cover the floor of the pit, becoming thicker to the right.&#10;Marks in the dust around the window would seem to indicate that&#10;someone has been here recently.  Directly across the pit from you and&#10;25 feet away there is a similar window looking into a lighted room.  A&#10;shadowy figure can be seen there peering back at you." description_es="" short_en="You're at window on pit." maptag="" chapter_id="CH_Y2_WINDOWS" source_reference="Open_Adventure.yaml locations/LOC_WINDOW1" review_status="ok" role="playable" conditions="DEEP=True" travel_rules="[{&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_Y2&quot;], &quot;action_target&quot;: &quot;LOC_Y2&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;EAST&quot;, &quot;Y2&quot;]}, {&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_NECKBROKE&quot;], &quot;action_target&quot;: &quot;LOC_NECKBROKE&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;JUMP&quot;]}]" objects_here="OBJ_27" immovable_objects_here="OBJ_27">
