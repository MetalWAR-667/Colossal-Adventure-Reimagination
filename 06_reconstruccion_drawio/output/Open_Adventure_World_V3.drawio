        <object id="N_LOC_KINGHALL" label="&lt;b&gt;LOC_KINGHALL — in Hall of Mt King&lt;/b&gt;&lt;hr size='1'/&gt;You are in the Hall of the Mountain King, with passages off in all&lt;br&gt;directions.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXITS (source precedence order)&lt;/b&gt;&lt;br&gt;1. STAIR, UPWAR, EAST → LOC_MISTHALL [Ch 02]&lt;br&gt;2. NORTH, RIGHT → LOC_FLOORHOLE [not SNAKE=SNAKE_BLOCKS]&lt;br&gt;3. SOUTH, LEFT → LOC_SOUTHSIDE [not SNAKE=SNAKE_BLOCKS]&lt;br&gt;4. WEST, FORWA → LOC_WESTSIDE [not SNAKE=SNAKE_BLOCKS]&lt;br&gt;5. NORTH → LOC_SNAKEBLOCK [Ch 11]&lt;br&gt;6. SW → LOC_SECRET3 [Ch 05] [35%]&lt;br&gt;7. SW → LOC_SNAKEBLOCK [Ch 11] [with SNAKE]&lt;br&gt;8. SECRE → LOC_SECRET3 [Ch 05]" source_id="LOC_KINGHALL" description_en="You are in the Hall of the Mountain King, with passages off in all&#10;directions." description_es="" short_en="You're in Hall of Mt King." maptag="" chapter_id="CH_CENTRAL" source_reference="Open_Adventure.yaml locations/LOC_KINGHALL" review_status="ok" role="playable" conditions="DEEP=True" travel_rules="[{&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_MISTHALL&quot;], &quot;action_target&quot;: &quot;LOC_MISTHALL&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;STAIR&quot;, &quot;UPWAR&quot;, &quot;EAST&quot;]}, {&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_FLOORHOLE&quot;], &quot;action_target&quot;: &quot;LOC_FLOORHOLE&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: {&quot;object&quot;: &quot;SNAKE&quot;, &quot;state&quot;: &quot;SNAKE_BLOCKS&quot;, &quot;type&quot;: &quot;not&quot;}, &quot;verbs&quot;: [&quot;NORTH&quot;, &quot;RIGHT&quot;]}, {&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_SOUTHSIDE&quot;], &quot;action_target&quot;: &quot;LOC_SOUTHSIDE&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: {&quot;object&quot;: &quot;SNAKE&quot;, &quot;state&quot;: &quot;SNAKE_BLOCKS&quot;, &quot;type&quot;: &quot;not&quot;}, &quot;verbs&quot;: [&quot;SOUTH&quot;, &quot;LEFT&quot;]}, {&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_WESTSIDE&quot;], &quot;action_target&quot;: &quot;LOC_WESTSIDE&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: {&quot;object&quot;: &quot;SNAKE&quot;, &quot;state&quot;: &quot;SNAKE_BLOCKS&quot;, &quot;type&quot;: &quot;not&quot;}, &quot;verbs&quot;: [&quot;WEST&quot;, &quot;FORWA&quot;]}, {&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_SNAKEBLOCK&quot;], &quot;action_target&quot;: &quot;LOC_SNAKEBLOCK&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;NORTH&quot;]}, {&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_SECRET3&quot;], &quot;action_target&quot;: &quot;LOC_SECRET3&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: {&quot;percent&quot;: 35, &quot;type&quot;: &quot;probability&quot;}, &quot;verbs&quot;: [&quot;SW&quot;]}, {&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_SNAKEBLOCK&quot;], &quot;action_target&quot;: &quot;LOC_SNAKEBLOCK&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: {&quot;object&quot;: &quot;SNAKE&quot;, &quot;type&quot;: &quot;with&quot;}, &quot;verbs&quot;: [&quot;SW&quot;]}, {&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_SECRET3&quot;], &quot;action_target&quot;: &quot;LOC_SECRET3&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;SECRE&quot;]}]" objects_here="SNAKE" immovable_objects_here="SNAKE">
