        <object id="N_LOC_DARKROOM" label="&lt;b&gt;LOC_DARKROOM — in dark-room&lt;/b&gt;&lt;hr size='1'/&gt;You&amp;#x27;re in the dark-room.  A corridor leading south is the only exit.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXITS (source precedence order)&lt;/b&gt;&lt;br&gt;1. SOUTH, PLOVE, OUT → LOC_PLOVER" source_id="LOC_DARKROOM" description_en="You're in the dark-room.  A corridor leading south is the only exit." description_es="" short_en="You're in dark-room." maptag="" chapter_id="CH_ORIENTAL_PLOVER" source_reference="Open_Adventure.yaml locations/LOC_DARKROOM" review_status="ok" role="playable" conditions="DEEP=True" travel_rules="[{&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_PLOVER&quot;], &quot;action_target&quot;: &quot;LOC_PLOVER&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;SOUTH&quot;, &quot;PLOVE&quot;, &quot;OUT&quot;]}]" objects_here="OBJ_13, PYRAMID" treasures_here="PYRAMID" immovable_objects_here="OBJ_13">
