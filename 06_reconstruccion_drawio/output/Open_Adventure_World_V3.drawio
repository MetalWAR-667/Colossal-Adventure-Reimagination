  <diagram id="CH_RESERVOIR" name="07 — Reservoir &amp; Cliff Ascent">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1660" pageHeight="3513" math="0" shadow="0">
