        <object id="N_LOC_DEBRIS" label="&lt;b&gt;LOC_DEBRIS — in debris room&lt;/b&gt;&lt;hr size='1'/&gt;You are in a debris room filled with stuff washed in from the surface.&lt;br&gt;A low wide passage with cobbles becomes plugged with mud and debris&lt;br&gt;here, but an awkward canyon leads upward and west.  In the mud someone&lt;br&gt;has scrawled, &amp;quot;MAGIC WORD XYZZY&amp;quot;.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXITS (source precedence order)&lt;/b&gt;&lt;br&gt;1. DEPRE → LOC_GRATE [Ch 01] [not GRATE=GRATE_CLOSED]&lt;br&gt;2. ENTRA → LOC_BELOWGRATE&lt;br&gt;3. CRAWL, COBBL, PASSA, LOW, EAST → LOC_COBBLE&lt;br&gt;4. CANYO, INWAR, UPWAR, WEST → LOC_AWKWARD&lt;br&gt;5. XYZZY → LOC_FOOF2 [Ch 01]&lt;br&gt;6. PIT → LOC_PITTOP" source_id="LOC_DEBRIS" description_en="You are in a debris room filled with stuff washed in from the surface.&#10;A low wide passage with cobbles becomes plugged with mud and debris&#10;here, but an awkward canyon leads upward and west.  In the mud someone&#10;has scrawled, &quot;MAGIC WORD XYZZY&quot;." description_es="" short_en="You're in debris room." maptag="" chapter_id="CH_ENTRY" source_reference="Open_Adventure.yaml locations/LOC_DEBRIS" review_status="ok" role="playable" conditions="" travel_rules="[{&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_GRATE&quot;], &quot;action_target&quot;: &quot;LOC_GRATE&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: {&quot;object&quot;: &quot;GRATE&quot;, &quot;state&quot;: &quot;GRATE_CLOSED&quot;, &quot;type&quot;: &quot;not&quot;}, &quot;verbs&quot;: [&quot;DEPRE&quot;]}, {&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_BELOWGRATE&quot;], &quot;action_target&quot;: &quot;LOC_BELOWGRATE&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;ENTRA&quot;]}, {&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_COBBLE&quot;], &quot;action_target&quot;: &quot;LOC_COBBLE&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;CRAWL&quot;, &quot;COBBL&quot;, &quot;PASSA&quot;, &quot;LOW&quot;, &quot;EAST&quot;]}, {&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_AWKWARD&quot;], &quot;action_target&quot;: &quot;LOC_AWKWARD&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;CANYO&quot;, &quot;INWAR&quot;, &quot;UPWAR&quot;, &quot;WEST&quot;]}, {&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_FOOF2&quot;], &quot;action_target&quot;: &quot;LOC_FOOF2&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;XYZZY&quot;]}, {&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_PITTOP&quot;], &quot;action_target&quot;: &quot;LOC_PITTOP&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;PIT&quot;]}]" objects_here="ROD, OBJ_47" immovable_objects_here="OBJ_47">
