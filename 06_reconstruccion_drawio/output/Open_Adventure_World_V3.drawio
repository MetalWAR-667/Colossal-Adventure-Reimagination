        <object id="N_LOC_WESTPIT" label="&lt;b&gt;LOC_WESTPIT — in west pit&lt;/b&gt;&lt;hr size='1'/&gt;You are at the bottom of the western pit in the Twopit Room.  There is&lt;br&gt;a large hole in the wall about 25 feet above you.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXITS (source precedence order)&lt;/b&gt;&lt;br&gt;1. UPWAR, OUT → LOC_WESTEND&lt;br&gt;2. CLIMB → LOC_BUILDING1 [not PLANT=PLANT_GROWN]&lt;br&gt;3. CLIMB → LOC_CLIMBSTALK" source_id="LOC_WESTPIT" description_en="You are at the bottom of the western pit in the Twopit Room.  There is&#10;a large hole in the wall about 25 feet above you." description_es="" short_en="You're in west pit." maptag="" chapter_id="CH_CENTRAL" source_reference="Open_Adventure.yaml locations/LOC_WESTPIT" review_status="ok" role="playable" conditions="DEEP=True" travel_rules="[{&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_WESTEND&quot;], &quot;action_target&quot;: &quot;LOC_WESTEND&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;UPWAR&quot;, &quot;OUT&quot;]}, {&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_BUILDING1&quot;], &quot;action_target&quot;: &quot;LOC_BUILDING1&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: {&quot;object&quot;: &quot;PLANT&quot;, &quot;state&quot;: &quot;PLANT_GROWN&quot;, &quot;type&quot;: &quot;not&quot;}, &quot;verbs&quot;: [&quot;CLIMB&quot;]}, {&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_CLIMBSTALK&quot;], &quot;action_target&quot;: &quot;LOC_CLIMBSTALK&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;CLIMB&quot;]}]" objects_here="PLANT" immovable_objects_here="PLANT">
