        <mxCell id="legend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#BDBDBD;align=left;verticalAlign=top;spacingLeft=10;spacingTop=5;fontSize=9.5;fontFamily=Helvetica;" value="&lt;b&gt;LEGEND &amp;amp; LAYERS&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Black solid (2.5 px):&lt;/b&gt; primary compass/passage movement (double arrowhead = two-way)&lt;br&gt;• &lt;b&gt;Blue solid (2.8 px):&lt;/b&gt; vertical UPWAR / DOWN shaft (distinct from compass N/S)&lt;br&gt;• &lt;b&gt;Purple dashed:&lt;/b&gt; magic word / special transition · &lt;b&gt;Local markers:&lt;/b&gt; yellow = cross-page · orange = transient · red = death&lt;br&gt;• &lt;b&gt;Optional layer [Parser Aliases / Fast Travel] (hidden by default):&lt;/b&gt; non-adjacent keyword shortcuts" vertex="1" parent="1">
          <mxGeometry x="206" y="46" width="740" height="92" as="geometry" />
        </mxCell>
        <object id="N_LOC_CLIFFACE" label="&lt;b&gt;LOC_CLIFFACE — Vertical cliff&lt;/b&gt;&lt;hr size='1'/&gt;You are climbing along a nearly vertical cliff.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXITS (source precedence order)&lt;/b&gt;&lt;br&gt;1. DOWN → LOC_CLIFFBASE&lt;br&gt;2. UPWAR → LOC_CLIFFTOP [carry RABBITFOOT]&lt;br&gt;3. UPWAR → LOC_FOOTSLIP [Ch 11]" source_id="LOC_CLIFFACE" description_en="You are climbing along a nearly vertical cliff." description_es="" short_en="" maptag="Vertical cliff." chapter_id="CH_RESERVOIR" source_reference="Open_Adventure.yaml locations/LOC_CLIFFACE" review_status="ok" role="playable" conditions="DEEP=True" travel_rules="[{&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_CLIFFBASE&quot;], &quot;action_target&quot;: &quot;LOC_CLIFFBASE&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;DOWN&quot;]}, {&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_CLIFFTOP&quot;], &quot;action_target&quot;: &quot;LOC_CLIFFTOP&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: {&quot;object&quot;: &quot;RABBITFOOT&quot;, &quot;type&quot;: &quot;carry&quot;}, &quot;verbs&quot;: [&quot;UPWAR&quot;]}, {&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_FOOTSLIP&quot;], &quot;action_target&quot;: &quot;LOC_FOOTSLIP&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;UPWAR&quot;]}]">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;arcSize=4;fontSize=10;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1">
            <mxGeometry x="182" y="770" width="290" height="150" as="geometry" />
          </mxCell>
        </object>
        <object id="N_LOC_CLIFFBASE" label="&lt;b&gt;LOC_CLIFFBASE — at base of cliff&lt;/b&gt;&lt;hr size='1'/&gt;You are at the base of a nearly vertical cliff.  There are some&lt;br&gt;slim footholds which would enable you to climb up, but it looks&lt;br&gt;extremely dangerous.  Here at the base of the cliff lie the remains&lt;br&gt;of several earlier adventurers who apparently failed to make it.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXITS (source precedence order)&lt;/b&gt;&lt;br&gt;1. DOWN, SE → LOC_STEEP&lt;br&gt;2. UPWAR, CLIMB → LOC_CLIFFACE" source_id="LOC_CLIFFBASE" description_en="You are at the base of a nearly vertical cliff.  There are some&#10;slim footholds which would enable you to climb up, but it looks&#10;extremely dangerous.  Here at the base of the cliff lie the remains&#10;of several earlier adventurers who apparently failed to make it." description_es="" short_en="You're at base of cliff." maptag="" chapter_id="CH_RESERVOIR" source_reference="Open_Adventure.yaml locations/LOC_CLIFFBASE" review_status="ok" role="playable" conditions="DEEP=True" travel_rules="[{&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_STEEP&quot;], &quot;action_target&quot;: &quot;LOC_STEEP&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;DOWN&quot;, &quot;SE&quot;]}, {&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_CLIFFACE&quot;], &quot;action_target&quot;: &quot;LOC_CLIFFACE&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;UPWAR&quot;, &quot;CLIMB&quot;]}]">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;arcSize=4;fontSize=10;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1">
            <mxGeometry x="80" y="1070" width="290" height="220" as="geometry" />
          </mxCell>
        </object>
        <object id="N_LOC_CLIFFLEDGE" label="&lt;b&gt;LOC_CLIFFLEDGE — at top of cliff&lt;/b&gt;&lt;hr size='1'/&gt;You are on a small ledge at the top of a nearly vertical cliff.&lt;br&gt;There is a low crawl leading off to the northeast.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXITS (source precedence order)&lt;/b&gt;&lt;br&gt;1. CLIMB, DOWN → LOC_CLIFFACE&lt;br&gt;2. NE, CRAWL → LOC_REACHDEAD" source_id="LOC_CLIFFLEDGE" description_en="You are on a small ledge at the top of a nearly vertical cliff.&#10;There is a low crawl leading off to the northeast." description_es="" short_en="You're at top of cliff." maptag="Clifftop" chapter_id="CH_RESERVOIR" source_reference="Open_Adventure.yaml locations/LOC_CLIFFLEDGE" review_status="ok" role="playable" conditions="DEEP=True" travel_rules="[{&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_CLIFFACE&quot;], &quot;action_target&quot;: &quot;LOC_CLIFFACE&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;CLIMB&quot;, &quot;DOWN&quot;]}, {&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_REACHDEAD&quot;], &quot;action_target&quot;: &quot;LOC_REACHDEAD&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;NE&quot;, &quot;CRAWL&quot;]}]">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;arcSize=4;fontSize=10;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1">
            <mxGeometry x="80" y="460" width="290" height="160" as="geometry" />
          </mxCell>
        </object>
        <object id="N_LOC_CLIFFTOP" label="&lt;b&gt;LOC_CLIFFTOP — LOC_CLIFFTOP&lt;/b&gt;&lt;hr size='1'/&gt;Just as you reach the top, your foot slips on a loose rock and you&lt;br&gt;make one last desperate grab.  Your luck holds, as does your grip.&lt;br&gt;With an enormous heave, you lift yourself to the ledge above.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXITS (source precedence order)&lt;/b&gt;&lt;br&gt;1. (implicit) → LOC_CLIFFLEDGE" source_id="LOC_CLIFFTOP" description_en="Just as you reach the top, your foot slips on a loose rock and you&#10;make one last desperate grab.  Your luck holds, as does your grip.&#10;With an enormous heave, you lift yourself to the ledge above." description_es="" short_en="" maptag="" chapter_id="CH_RESERVOIR" source_reference="Open_Adventure.yaml locations/LOC_CLIFFTOP" review_status="ok" role="transient" conditions="DEEP=True" travel_rules="[{&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_CLIFFLEDGE&quot;], &quot;action_target&quot;: &quot;LOC_CLIFFLEDGE&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: []}]">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#333333;strokeWidth=1.5;dashed=1;arcSize=4;fontSize=10;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1">
            <mxGeometry x="490" y="440" width="290" height="180" as="geometry" />
          </mxCell>
        </object>
        <object id="N_LOC_MIRRORCANYON" label="&lt;b&gt;LOC_MIRRORCANYON — in Mirror Canyon&lt;/b&gt;&lt;hr size='1'/&gt;You are in a north/south canyon about 25 feet across.  The floor is&lt;br&gt;covered by white mist seeping in from the north.  The walls extend&lt;br&gt;upward for well over 100 feet.  Suspended from some unseen point far&lt;br&gt;above you, an enormous two-sided mirror is hanging parallel to and&lt;br&gt;midway between the canyon walls.  (The mirror is obviously provided&lt;br&gt;for the use of the dwarves who, as you know, are extremely vain.)  A&lt;br&gt;small window can be seen in either wall, some fifty feet up.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXITS (source precedence order)&lt;/b&gt;&lt;br&gt;1. SOUTH → LOC_SECRET1 [Ch 05]&lt;br&gt;2. NORTH, RESER → LOC_RESERVOIR" source_id="LOC_MIRRORCANYON" description_en="You are in a north/south canyon about 25 feet across.  The floor is&#10;covered by white mist seeping in from the north.  The walls extend&#10;upward for well over 100 feet.  Suspended from some unseen point far&#10;above you, an enormous two-sided mirror is hanging parallel to and&#10;midway between the canyon walls.  (The mirror is obviously provided&#10;for the use of the dwarves who, as you know, are extremely vain.)  A&#10;small window can be seen in either wall, some fifty feet up." description_es="" short_en="You're in Mirror Canyon." maptag="" chapter_id="CH_RESERVOIR" source_reference="Open_Adventure.yaml locations/LOC_MIRRORCANYON" review_status="ok" role="playable" conditions="DEEP=True" travel_rules="[{&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_SECRET1&quot;], &quot;action_target&quot;: &quot;LOC_SECRET1&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;SOUTH&quot;]}, {&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_RESERVOIR&quot;], &quot;action_target&quot;: &quot;LOC_RESERVOIR&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;NORTH&quot;, &quot;RESER&quot;]}]" objects_here="MIRROR" immovable_objects_here="MIRROR" sound="WIND_WHISTLES">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;arcSize=4;fontSize=10;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1">
            <mxGeometry x="1309" y="3080" width="290" height="300" as="geometry" />
          </mxCell>
        </object>
        <object id="N_LOC_REACHDEAD" label="&lt;b&gt;LOC_REACHDEAD — Dead end&lt;/b&gt;&lt;hr size='1'/&gt;You have reached a dead end.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXITS (source precedence order)&lt;/b&gt;&lt;br&gt;1. SW, OUT, CRAWL → LOC_CLIFFLEDGE" source_id="LOC_REACHDEAD" description_en="You have reached a dead end." description_es="" short_en="" maptag="Dead end." chapter_id="CH_RESERVOIR" source_reference="Open_Adventure.yaml locations/LOC_REACHDEAD" review_status="ok" role="playable" conditions="DEEP=True" travel_rules="[{&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_CLIFFLEDGE&quot;], &quot;action_target&quot;: &quot;LOC_CLIFFLEDGE&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;SW&quot;, &quot;OUT&quot;, &quot;CRAWL&quot;]}]" objects_here="OBJ_69" treasures_here="OBJ_69">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;arcSize=4;fontSize=10;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1">
            <mxGeometry x="490" y="190" width="290" height="120" as="geometry" />
