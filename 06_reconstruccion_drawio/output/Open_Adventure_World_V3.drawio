            <mxGeometry x="490" y="540" width="290" height="200" as="geometry" />
          </mxCell>
        </object>
        <object id="N_LOC_ARCHED" label="&lt;b&gt;LOC_ARCHED — in arched hall&lt;/b&gt;&lt;hr size='1'/&gt;You are in an arched hall.  A coral passage once continued up and east&lt;br&gt;from here, but is now blocked by debris.  The air smells of sea water.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXITS (source precedence order)&lt;/b&gt;&lt;br&gt;1. DOWN, SHELL, OUT → LOC_SHELLROOM" source_id="LOC_ARCHED" description_en="You are in an arched hall.  A coral passage once continued up and east&#10;from here, but is now blocked by debris.  The air smells of sea water." description_es="" short_en="You're in arched hall." maptag="" chapter_id="CH_ORIENTAL_PLOVER" source_reference="Open_Adventure.yaml locations/LOC_ARCHED" review_status="ok" role="playable" conditions="DEEP=True" travel_rules="[{&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_SHELLROOM&quot;], &quot;action_target&quot;: &quot;LOC_SHELLROOM&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;DOWN&quot;, &quot;SHELL&quot;, &quot;OUT&quot;]}]">
