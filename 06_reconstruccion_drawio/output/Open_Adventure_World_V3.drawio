        <object id="N_LOC_SWISSCHEESE" label="&lt;b&gt;LOC_SWISSCHEESE — in Swiss Cheese Room&lt;/b&gt;&lt;hr size='1'/&gt;You are in a room whose walls resemble Swiss cheese.  Obvious passages&lt;br&gt;go west, east, ne, and nw.  Part of the room is occupied by a large&lt;br&gt;bedrock block.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXITS (source precedence order)&lt;/b&gt;&lt;br&gt;1. NE → LOC_BEDQUILT&lt;br&gt;2. WEST → LOC_EASTEND [Ch 03]&lt;br&gt;3. SOUTH ✕ msg FUTILE_CRAWL [80%]&lt;br&gt;4. CANYO → LOC_TALL&lt;br&gt;5. EAST → LOC_SOFTROOM [Ch 06]&lt;br&gt;6. NW ✕ msg FUTILE_CRAWL [50%]&lt;br&gt;7. ORIEN → LOC_ORIENTAL [Ch 06]" source_id="LOC_SWISSCHEESE" description_en="You are in a room whose walls resemble Swiss cheese.  Obvious passages&#10;go west, east, ne, and nw.  Part of the room is occupied by a large&#10;bedrock block." description_es="" short_en="You're in Swiss Cheese Room." maptag="" chapter_id="CH_BEDQUILT" source_reference="Open_Adventure.yaml locations/LOC_SWISSCHEESE" review_status="ok" role="playable" conditions="DEEP=True" travel_rules="[{&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_BEDQUILT&quot;], &quot;action_target&quot;: &quot;LOC_BEDQUILT&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;NE&quot;]}, {&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_EASTEND&quot;], &quot;action_target&quot;: &quot;LOC_EASTEND&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;WEST&quot;]}, {&quot;action_full&quot;: [&quot;speak&quot;, &quot;FUTILE_CRAWL&quot;], &quot;action_target&quot;: &quot;FUTILE_CRAWL&quot;, &quot;action_type&quot;: &quot;speak&quot;, &quot;cond&quot;: {&quot;percent&quot;: 80, &quot;type&quot;: &quot;probability&quot;}, &quot;verbs&quot;: [&quot;SOUTH&quot;]}, {&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_TALL&quot;], &quot;action_target&quot;: &quot;LOC_TALL&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;CANYO&quot;]}, {&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_SOFTROOM&quot;], &quot;action_target&quot;: &quot;LOC_SOFTROOM&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;EAST&quot;]}, {&quot;action_full&quot;: [&quot;speak&quot;, &quot;FUTILE_CRAWL&quot;], &quot;action_target&quot;: &quot;FUTILE_CRAWL&quot;, &quot;action_type&quot;: &quot;speak&quot;, &quot;cond&quot;: {&quot;percent&quot;: 50, &quot;type&quot;: &quot;probability&quot;}, &quot;verbs&quot;: [&quot;NW&quot;]}, {&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_ORIENTAL&quot;], &quot;action_target&quot;: &quot;LOC_ORIENTAL&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;ORIEN&quot;]}]" blocked_messages="SOUTH → FUTILE_CRAWL [80%] | NW → FUTILE_CRAWL [50%]">
