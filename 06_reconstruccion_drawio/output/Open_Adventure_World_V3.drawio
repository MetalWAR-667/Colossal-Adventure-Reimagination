        <object id="N_LOC_FLOORHOLE" label="&lt;b&gt;LOC_FLOORHOLE — in n/s passage above e/w passage&lt;/b&gt;&lt;hr size='1'/&gt;You are in a low n/s passage at a hole in the floor.  The hole goes&lt;br&gt;down to an e/w passage.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXITS (source precedence order)&lt;/b&gt;&lt;br&gt;1. HALL, OUT, SOUTH → LOC_KINGHALL&lt;br&gt;2. NORTH, Y2 → LOC_Y2 [Ch 10]&lt;br&gt;3. DOWN, HOLE → LOC_BROKEN [Ch 10]" source_id="LOC_FLOORHOLE" description_en="You are in a low n/s passage at a hole in the floor.  The hole goes&#10;down to an e/w passage." description_es="" short_en="You're in n/s passage above e/w passage." maptag="Floor hole." chapter_id="CH_CENTRAL" source_reference="Open_Adventure.yaml locations/LOC_FLOORHOLE" review_status="ok" role="playable" conditions="DEEP=True" travel_rules="[{&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_KINGHALL&quot;], &quot;action_target&quot;: &quot;LOC_KINGHALL&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;HALL&quot;, &quot;OUT&quot;, &quot;SOUTH&quot;]}, {&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_Y2&quot;], &quot;action_target&quot;: &quot;LOC_Y2&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;NORTH&quot;, &quot;Y2&quot;]}, {&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_BROKEN&quot;], &quot;action_target&quot;: &quot;LOC_BROKEN&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;DOWN&quot;, &quot;HOLE&quot;]}]" objects_here="OBJ_52" treasures_here="OBJ_52">
