        </object>
        <object id="N_LOC_RESBOTTOM" label="&lt;b&gt;LOC_RESBOTTOM — at bottom of reservoir&lt;/b&gt;&lt;hr size='1'/&gt;You are walking across the bottom of the reservoir.  Walls of water&lt;br&gt;rear up on either side.  The roar of the water cascading past is&lt;br&gt;nearly deafening, and the mist is so thick you can barely see.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXITS (source precedence order)&lt;/b&gt;&lt;br&gt;1. NORTH → LOC_RESNORTH&lt;br&gt;2. SOUTH → LOC_RESERVOIR" source_id="LOC_RESBOTTOM" description_en="You are walking across the bottom of the reservoir.  Walls of water&#10;rear up on either side.  The roar of the water cascading past is&#10;nearly deafening, and the mist is so thick you can barely see." description_es="" short_en="You're at bottom of reservoir." maptag="" chapter_id="CH_RESERVOIR" source_reference="Open_Adventure.yaml locations/LOC_RESBOTTOM" review_status="ok" role="playable" conditions="DEEP=True, FLUID=True" travel_rules="[{&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_RESNORTH&quot;], &quot;action_target&quot;: &quot;LOC_RESNORTH&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;NORTH&quot;]}, {&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_RESERVOIR&quot;], &quot;action_target&quot;: &quot;LOC_RESERVOIR&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;SOUTH&quot;]}]" sound="TOTAL_ROAR" loud="true">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;arcSize=4;fontSize=10;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1">
            <mxGeometry x="1309" y="2320" width="290" height="190" as="geometry" />
          </mxCell>
        </object>
        <object id="N_LOC_RESERVOIR" label="&lt;b&gt;LOC_RESERVOIR — at reservoir&lt;/b&gt;&lt;hr size='1'/&gt;You are at the edge of a large underground reservoir.  An opaque cloud&lt;br&gt;of white mist fills the room and rises rapidly upward.  The lake is&lt;br&gt;fed by a stream, which tumbles out of a hole in the wall about 10 feet&lt;br&gt;overhead and splashes noisily into the water somewhere within the&lt;br&gt;mist.  There is a passage going back toward the south.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXITS (source precedence order)&lt;/b&gt;&lt;br&gt;1. SOUTH, OUT → LOC_MIRRORCANYON&lt;br&gt;2. NORTH, ACROS, CROSS ✕ msg BAD_DIRECTION [not RESER=WATERS_PARTED]&lt;br&gt;3. NORTH → LOC_RESBOTTOM" source_id="LOC_RESERVOIR" description_en="You are at the edge of a large underground reservoir.  An opaque cloud&#10;of white mist fills the room and rises rapidly upward.  The lake is&#10;fed by a stream, which tumbles out of a hole in the wall about 10 feet&#10;overhead and splashes noisily into the water somewhere within the&#10;mist.  There is a passage going back toward the south." description_es="" short_en="You're at reservoir." maptag="" chapter_id="CH_RESERVOIR" source_reference="Open_Adventure.yaml locations/LOC_RESERVOIR" review_status="ok" role="playable" conditions="DEEP=True, FLUID=True" travel_rules="[{&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_MIRRORCANYON&quot;], &quot;action_target&quot;: &quot;LOC_MIRRORCANYON&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;SOUTH&quot;, &quot;OUT&quot;]}, {&quot;action_full&quot;: [&quot;speak&quot;, &quot;BAD_DIRECTION&quot;], &quot;action_target&quot;: &quot;BAD_DIRECTION&quot;, &quot;action_type&quot;: &quot;speak&quot;, &quot;cond&quot;: {&quot;object&quot;: &quot;RESER&quot;, &quot;state&quot;: &quot;WATERS_PARTED&quot;, &quot;type&quot;: &quot;not&quot;}, &quot;verbs&quot;: [&quot;NORTH&quot;, &quot;ACROS&quot;, &quot;CROSS&quot;]}, {&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_RESBOTTOM&quot;], &quot;action_target&quot;: &quot;LOC_RESBOTTOM&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;NORTH&quot;]}]" blocked_messages="NORTH, ACROS, CROSS → BAD_DIRECTION [not RESER=WATERS_PARTED]" objects_here="RESER" immovable_objects_here="RESER" sound="STREAM_SPLASHES">
