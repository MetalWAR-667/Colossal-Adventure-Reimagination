        </object>
        <object id="N_LOC_CULDESAC" label="&lt;b&gt;LOC_CULDESAC — Cul-de-sac&lt;/b&gt;&lt;hr size='1'/&gt;You are in a cul-de-sac about eight feet across.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXITS (source precedence order)&lt;/b&gt;&lt;br&gt;1. UPWAR, OUT → LOC_SLOPING1&lt;br&gt;2. SHELL → LOC_SHELLROOM" source_id="LOC_CULDESAC" description_en="You are in a cul-de-sac about eight feet across." description_es="" short_en="" maptag="Cul-de-sac." chapter_id="CH_ORIENTAL_PLOVER" source_reference="Open_Adventure.yaml locations/LOC_CULDESAC" review_status="ok" role="playable" conditions="DEEP=True" travel_rules="[{&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_SLOPING1&quot;], &quot;action_target&quot;: &quot;LOC_SLOPING1&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;UPWAR&quot;, &quot;OUT&quot;]}, {&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_SHELLROOM&quot;], &quot;action_target&quot;: &quot;LOC_SHELLROOM&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;SHELL&quot;]}]">
