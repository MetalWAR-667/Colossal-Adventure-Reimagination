        <object id="N_LOC_LOWROOM" label="&lt;b&gt;LOC_LOWROOM — in large low room&lt;/b&gt;&lt;hr size='1'/&gt;You are in a large low room.  Crawls lead north, se, and sw.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXITS (source precedence order)&lt;/b&gt;&lt;br&gt;1. BEDQU → LOC_BEDQUILT&lt;br&gt;2. SW → LOC_WINDING [Ch 08]&lt;br&gt;3. NORTH → LOC_DEADCRAWL&lt;br&gt;4. SE, ORIEN → LOC_ORIENTAL [Ch 06]" source_id="LOC_LOWROOM" description_en="You are in a large low room.  Crawls lead north, se, and sw." description_es="" short_en="You're in large low room." maptag="" chapter_id="CH_BEDQUILT" source_reference="Open_Adventure.yaml locations/LOC_LOWROOM" review_status="ok" role="playable" conditions="DEEP=True" travel_rules="[{&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_BEDQUILT&quot;], &quot;action_target&quot;: &quot;LOC_BEDQUILT&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;BEDQU&quot;]}, {&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_WINDING&quot;], &quot;action_target&quot;: &quot;LOC_WINDING&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;SW&quot;]}, {&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_DEADCRAWL&quot;], &quot;action_target&quot;: &quot;LOC_DEADCRAWL&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;NORTH&quot;]}, {&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_ORIENTAL&quot;], &quot;action_target&quot;: &quot;LOC_ORIENTAL&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;SE&quot;, &quot;ORIEN&quot;]}]">
