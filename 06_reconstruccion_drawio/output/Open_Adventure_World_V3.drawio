          </mxCell>
        </object>
        <object id="N_LOC_RESNORTH" label="&lt;b&gt;LOC_RESNORTH — north of reservoir&lt;/b&gt;&lt;hr size='1'/&gt;You are at the northern edge of the reservoir.  A northwest passage&lt;br&gt;leads sharply up from here.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXITS (source precedence order)&lt;/b&gt;&lt;br&gt;1. SOUTH, ACROS, CROSS ✕ msg BAD_DIRECTION [not RESER=WATERS_PARTED]&lt;br&gt;2. SOUTH → LOC_RESBOTTOM&lt;br&gt;3. NW, UPWAR, OUT → LOC_TREACHEROUS" source_id="LOC_RESNORTH" description_en="You are at the northern edge of the reservoir.  A northwest passage&#10;leads sharply up from here." description_es="" short_en="You're north of reservoir." maptag="" chapter_id="CH_RESERVOIR" source_reference="Open_Adventure.yaml locations/LOC_RESNORTH" review_status="ok" role="playable" conditions="DEEP=True, FLUID=True" travel_rules="[{&quot;action_full&quot;: [&quot;speak&quot;, &quot;BAD_DIRECTION&quot;], &quot;action_target&quot;: &quot;BAD_DIRECTION&quot;, &quot;action_type&quot;: &quot;speak&quot;, &quot;cond&quot;: {&quot;object&quot;: &quot;RESER&quot;, &quot;state&quot;: &quot;WATERS_PARTED&quot;, &quot;type&quot;: &quot;not&quot;}, &quot;verbs&quot;: [&quot;SOUTH&quot;, &quot;ACROS&quot;, &quot;CROSS&quot;]}, {&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_RESBOTTOM&quot;], &quot;action_target&quot;: &quot;LOC_RESBOTTOM&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;SOUTH&quot;]}, {&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_TREACHEROUS&quot;], &quot;action_target&quot;: &quot;LOC_TREACHEROUS&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;NW&quot;, &quot;UPWAR&quot;, &quot;OUT&quot;]}]" blocked_messages="SOUTH, ACROS, CROSS → BAD_DIRECTION [not RESER=WATERS_PARTED]" objects_here="RESER" immovable_objects_here="RESER" sound="WATERS_CRASHING">
