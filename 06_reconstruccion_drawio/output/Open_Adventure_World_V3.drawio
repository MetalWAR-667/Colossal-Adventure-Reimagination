        <object id="N_LOC_CROSSOVER" label="&lt;b&gt;LOC_CROSSOVER — Passage crossover&lt;/b&gt;&lt;hr size='1'/&gt;You are at a crossover of a high n/s passage and a low e/w one.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXITS (source precedence order)&lt;/b&gt;&lt;br&gt;1. WEST → LOC_LONGEAST [Ch 04]&lt;br&gt;2. NORTH → LOC_DEADEND7 [Ch 04]&lt;br&gt;3. EAST → LOC_WESTSIDE&lt;br&gt;4. SOUTH → LOC_LONGWEST [Ch 04]" source_id="LOC_CROSSOVER" description_en="You are at a crossover of a high n/s passage and a low e/w one." description_es="" short_en="" maptag="Passage crossover." chapter_id="CH_CENTRAL" source_reference="Open_Adventure.yaml locations/LOC_CROSSOVER" review_status="ok" role="playable" conditions="DEEP=True" travel_rules="[{&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_LONGEAST&quot;], &quot;action_target&quot;: &quot;LOC_LONGEAST&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;WEST&quot;]}, {&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_DEADEND7&quot;], &quot;action_target&quot;: &quot;LOC_DEADEND7&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;NORTH&quot;]}, {&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_WESTSIDE&quot;], &quot;action_target&quot;: &quot;LOC_WESTSIDE&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;EAST&quot;]}, {&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_LONGWEST&quot;], &quot;action_target&quot;: &quot;LOC_LONGWEST&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;SOUTH&quot;]}]">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;arcSize=4;fontSize=10;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1">
