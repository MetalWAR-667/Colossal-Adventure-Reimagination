        </object>
        <object id="N_LOC_BOULDERS2" label="&lt;b&gt;LOC_BOULDERS2 — in Chamber of Boulders&lt;/b&gt;&lt;hr size='1'/&gt;You are in a small chamber filled with large boulders.  The walls are&lt;br&gt;very warm, causing the air in the room to be almost stifling from the&lt;br&gt;heat.  The only exit is a crawl heading west, through which is coming&lt;br&gt;a low rumbling.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXITS (source precedence order)&lt;/b&gt;&lt;br&gt;1. WEST, OUT, CRAWL → LOC_WARMWALLS&lt;br&gt;2. FORK → LOC_FORK&lt;br&gt;3. VIEW → LOC_BREATHTAKING" source_id="LOC_BOULDERS2" description_en="You are in a small chamber filled with large boulders.  The walls are&#10;very warm, causing the air in the room to be almost stifling from the&#10;heat.  The only exit is a crawl heading west, through which is coming&#10;a low rumbling." description_es="" short_en="You're in Chamber of Boulders." maptag="" chapter_id="CH_REPOSITORY" source_reference="Open_Adventure.yaml locations/LOC_BOULDERS2" review_status="ok" role="playable" conditions="DEEP=True, NOARRR=True" travel_rules="[{&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_WARMWALLS&quot;], &quot;action_target&quot;: &quot;LOC_WARMWALLS&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;WEST&quot;, &quot;OUT&quot;, &quot;CRAWL&quot;]}, {&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_FORK&quot;], &quot;action_target&quot;: &quot;LOC_FORK&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;FORK&quot;]}, {&quot;action_full&quot;: [&quot;goto&quot;, &quot;LOC_BREATHTAKING&quot;], &quot;action_target&quot;: &quot;LOC_BREATHTAKING&quot;, &quot;action_type&quot;: &quot;goto&quot;, &quot;cond&quot;: null, &quot;verbs&quot;: [&quot;VIEW&quot;]}]" objects_here="OBJ_63" treasures_here="OBJ_63" sound="DULL_RUMBLING">
