# Loads the exported chapter dataset and the hand-written Spanish text pack.
#
# The dataset is generated by `07_godot_open_adventure/tools/oa_export_godot.py`
# from the Open Adventure YAML; it is never edited by hand.  The Spanish text
# pack is authored separately so that the historical source text and the
# reinterpretation stay in different files.
class_name WorldData
extends RefCounted

const DATASET_PATH := "res://data/chapter_01_surface.json"
const L10N_PATH := "res://data/l10n_es.json"
const ART_PATH := "res://data/art_ch01.json"

var meta: Dictionary = {}
var chapter_id: String = ""
var chapter_title: String = ""
var chapter_description: String = ""
var locations: Dictionary = {}
var objects: Dictionary = {}
var messages: Dictionary = {}
var frontier: Dictionary = {}
var classes: Array[Dictionary] = []
var num_deaths: int = 0
var chest_index: int = -1
var motion_verbs: Dictionary = {}
var action_verbs: Dictionary = {}
var action_messages: Dictionary = {}
var map_nodes: Array[Dictionary] = []
var map_edges: Array[Dictionary] = []
var page_size: Vector2 = Vector2.ZERO

var ui_text: Dictionary = {}
var l10n_locations: Dictionary = {}
var l10n_messages: Dictionary = {}
var l10n_objects: Dictionary = {}
var art: Dictionary = {}


static func load_default() -> WorldData:
	var world := WorldData.new()
	world.load_dataset(DATASET_PATH)
	world.load_l10n(L10N_PATH)
	world.load_art(ART_PATH)
	return world


func load_dataset(path: String) -> bool:
	var text := FileAccess.get_file_as_string(path)
	if text.is_empty():
		push_error("WorldData: cannot read %s" % path)
		return false
	var parsed: Variant = JSON.parse_string(text)
	if typeof(parsed) != TYPE_DICTIONARY:
		push_error("WorldData: %s is not a JSON object" % path)
		return false
	var data: Dictionary = parsed
	meta = data.get("meta", {})
	chapter_id = String(meta.get("chapter_id", ""))
	chapter_title = String(meta.get("chapter_title", ""))
	chapter_description = String(meta.get("chapter_description", ""))

	for key in data.get("locations", {}).keys():
		var loc := WorldLocation.from_dict(data["locations"][key])
		locations[loc.id] = loc
	for key in data.get("objects", {}).keys():
		var obj := WorldObject.from_dict(data["objects"][key])
		objects[obj.id] = obj
	messages = data.get("messages", {})
	frontier = data.get("frontier", {})
	classes.clear()
	for entry in data.get("classes", []):
		classes.append(entry)
	num_deaths = int(data.get("num_deaths", 0))
	chest_index = int(data.get("chest_index", -1))

	var verbs: Dictionary = data.get("verbs", {})
	motion_verbs = verbs.get("motions", {})
	action_verbs = verbs.get("actions", {})
	action_messages = verbs.get("action_messages", {})

	var map_data: Dictionary = data.get("map", {})
	map_nodes.clear()
	for node in map_data.get("nodes", []):
		map_nodes.append(node)
	map_edges.clear()
	for edge in map_data.get("edges", []):
		map_edges.append(edge)
	page_size = Vector2(
		float(map_data.get("page_width", 0.0)),
		float(map_data.get("page_height", 0.0))
	)
	_resolve_motion_names()
	return true


## The source stores travel verbs as five-letter word stems ("DOWNS"), while
## the parser resolves the typed word to a motion name ("MOT_5").  Both sides
## are mapped through the same table so the comparison happens on names.
func _resolve_motion_names() -> void:
	var lookup: Dictionary = {}
	for word in motion_verbs.keys():
		lookup[String(word).to_upper()] = String(motion_verbs[word])
	for location_id in locations.keys():
		var loc: WorldLocation = locations[location_id]
		for rule in loc.travel:
			rule.motion_names.clear()
			for verb in rule.verbs:
				var name := String(lookup.get(String(verb).to_upper(), String(verb)))
				rule.motion_names.append(name)


func load_l10n(path: String) -> bool:
	var text := FileAccess.get_file_as_string(path)
	if text.is_empty():
		push_warning("WorldData: no Spanish text pack at %s, falling back to English" % path)
		return false
	var parsed: Variant = JSON.parse_string(text)
	if typeof(parsed) != TYPE_DICTIONARY:
		push_error("WorldData: %s is not a JSON object" % path)
		return false
	var data: Dictionary = parsed
	ui_text = data.get("ui", {})
	l10n_locations = data.get("locations", {})
	l10n_messages = data.get("messages", {})
	l10n_objects = data.get("objects", {})
	return true


func load_art(path: String) -> bool:
	var text := FileAccess.get_file_as_string(path)
	if text.is_empty():
		return false
	var parsed: Variant = JSON.parse_string(text)
	if typeof(parsed) != TYPE_DICTIONARY:
		return false
	art = parsed
	return true


# ---------------------------------------------------------------------------
# lookups
# ---------------------------------------------------------------------------

func location(location_id: String) -> WorldLocation:
	if locations.has(location_id):
		return locations[location_id]
	return null


func world_object(object_id: String) -> WorldObject:
	if objects.has(object_id):
		return objects[object_id]
	return null


func is_in_chapter(location_id: String) -> bool:
	return locations.has(location_id)


func frontier_sources(location_id: String) -> PackedStringArray:
	return PackedStringArray(frontier.get(location_id, []))


## Long description of a room, Spanish first, English as fallback.
func describe(location_id: String) -> String:
	var entry: Dictionary = _localized_location(location_id)
	if entry.has("desc"):
		return String(entry["desc"])
	var loc := location(location_id)
	return loc.description_en if loc != null else ""


## Short description used when the room has already been visited.
func describe_short(location_id: String) -> String:
	var entry: Dictionary = _localized_location(location_id)
	if entry.has("short"):
		return String(entry["short"])
	var loc := location(location_id)
	return loc.short_en if loc != null else ""


func _localized_location(location_id: String) -> Dictionary:
	if l10n_locations.has(location_id):
		return l10n_locations[location_id]
	# All forest cells share one text; the source gives them the same room.
	if location_id.begins_with("LOC_FOREST") and l10n_locations.has("LOC_FOREST"):
		return l10n_locations["LOC_FOREST"]
	return {}


## Arbitrary message from the source, translated when a translation exists.
func message(message_id: String) -> String:
	if l10n_messages.has(message_id):
		return String(l10n_messages[message_id])
	if messages.has(message_id):
		return String(messages[message_id])
	return ""


func action_message(action: String) -> String:
	if l10n_messages.has(action):
		return String(l10n_messages[action])
	if action_messages.has(action):
		return String(action_messages[action])
	return ""


func ui(key: String) -> String:
	return String(ui_text.get(key, ""))


## Multi-line interface texts (help, legal notices) kept as an array.
func ui_lines(key: String) -> PackedStringArray:
	var lines := PackedStringArray()
	for line in ui_text.get(key, []):
		lines.append(String(line))
	return lines


func object_description(obj: WorldObject) -> String:
	var entry: Dictionary = l10n_objects.get(obj.id, {})
	var descriptions: Array = entry.get("descriptions", [])
	if descriptions.is_empty():
		return obj.description_for(obj.initial_state)
	return String(descriptions[0])


func object_description_for_state(obj: WorldObject, state_name: String) -> String:
	var entry: Dictionary = l10n_objects.get(obj.id, {})
	var descriptions: Array = entry.get("descriptions", [])
	var index := obj.state_index(state_name)
	if index >= 0 and index < descriptions.size():
		return String(descriptions[index])
	if not descriptions.is_empty():
		return String(descriptions[0])
	return obj.description_for(state_name)


func object_change_message(obj: WorldObject, state_name: String) -> String:
	var entry: Dictionary = l10n_objects.get(obj.id, {})
	var changes: Array = entry.get("changes", [])
	var index := obj.state_index(state_name)
	if index >= 0 and index < changes.size():
		return String(changes[index])
	return ""
